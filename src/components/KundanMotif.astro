---
/**
 * KUNDAN MOTIF — how a job runs, drawn as you scroll.
 *
 * The stage pins, and a kundan medallion is made in front of the visitor in
 * the same order the workshop makes one:
 *   design   silver sketch lines draw themselves
 *   weight   the sketch settles; a fine scale line measures across it
 *   gold in  grains of gold fly in and take their places round the rim
 *   ghaat    the gold framework is drawn over the sketch
 *   setting  the stones go in one by one, each with a glint
 *   finish   a band of light sweeps across the finished piece
 * A counter and the step's own words change alongside.
 *
 * The medallion is an illustration generated from simple geometry below, not
 * a photograph of a real piece. With JavaScript off or reduced motion, the
 * finished medallion shows beside an ordinary list of the steps.
 */
interface Props {
  steps: [string, string][];
  eyebrow: string;
  title: string;
}
const { steps, eyebrow, title } = Astro.props;
const total = String(steps.length).padStart(2, '0');

const C = 200; // centre of the 400 × 400 drawing
const pt = (r: number, a: number) => [C + r * Math.cos(a), C + r * Math.sin(a)];
const f = (n: number) => n.toFixed(2);

// eight petals, teardrops pointing outwards
const petals = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
  const [x0, y0] = pt(44, a);
  const [x1, y1] = pt(118, a);
  const [cx1, cy1] = pt(86, a - 0.34);
  const [cx2, cy2] = pt(86, a + 0.34);
  return `M${f(x0)} ${f(y0)} Q${f(cx1)} ${f(cy1)} ${f(x1)} ${f(y1)} Q${f(cx2)} ${f(cy2)} ${f(x0)} ${f(y0)}Z`;
});
// a stone in each petal, ruby and emerald by turns
const petalStones = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
  const [x, y] = pt(80, a);
  return { x, y, rot: (a * 180) / Math.PI + 90, tone: i % 2 ? 'emerald' : 'ruby' };
});
// small stones between the petals
const midStones = Array.from({ length: 8 }, (_, i) => {
  const a = ((i + 0.5) / 8) * Math.PI * 2 - Math.PI / 2;
  const [x, y] = pt(104, a);
  return { x, y };
});
// scalloped rim: 24 arcs between two rings
const scallop = (() => {
  const n = 24;
  let d = '';
  for (let i = 0; i < n; i++) {
    const a0 = (i / n) * Math.PI * 2, a1 = ((i + 1) / n) * Math.PI * 2;
    const [x0, y0] = pt(150, a0), [x1, y1] = pt(150, a1);
    d += `${i ? '' : `M${f(x0)} ${f(y0)} `}A12 12 0 0 1 ${f(x1)} ${f(y1)} `;
  }
  return d.trim();
})();
// gold grains round the rim, with a scattered start point for each
const grains = Array.from({ length: 36 }, (_, i) => {
  const a = (i / 36) * Math.PI * 2;
  const [x, y] = pt(166, a);
  const s = Math.sin(i * 12.9898) * 43758.5453;
  const rnd = s - Math.floor(s);
  const [sx, sy] = pt(330 + rnd * 160, a + (rnd - 0.5) * 2.2);
  return { x, y, dx: sx - x, dy: sy - y, k: i / 36 };
});
const allStones = [
  ...petalStones.map((s) => ({ ...s, kind: 'petal' })),
  ...midStones.map((s) => ({ ...s, kind: 'mid' })),
];
---

<section class="motif on-ink" data-motif>
  <div class="motif__stage">
    <div class="wrap motif__grid">
      <div class="motif__text">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        <p class="motif__count" aria-hidden="true"><b data-motif-count>01</b> / {total}</p>
        <ol class="motif__steps">
          {steps.map(([name, detail], i) => (
            <li>
              <span class="motif__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{name}</h3>
              <p>{detail}</p>
            </li>
          ))}
        </ol>
        <slot />
      </div>

      <svg class="motif__art" viewBox="0 0 400 400" role="img" aria-label="A kundan medallion being made: sketched, framed in gold, and set with stones">
        <defs>
          <radialGradient id="m-polki" cx="40%" cy="35%" r="70%">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="0.55" stop-color="#efe9dc" />
            <stop offset="1" stop-color="#b9b2a2" />
          </radialGradient>
          <radialGradient id="m-ruby" cx="40%" cy="35%" r="70%">
            <stop offset="0" stop-color="#ff6b7d" />
            <stop offset="0.5" stop-color="#b3132f" />
            <stop offset="1" stop-color="#5e0816" />
          </radialGradient>
          <radialGradient id="m-emerald" cx="40%" cy="35%" r="70%">
            <stop offset="0" stop-color="#7fe0b4" />
            <stop offset="0.5" stop-color="#1d7a55" />
            <stop offset="1" stop-color="#0b3a28" />
          </radialGradient>
          <linearGradient id="m-gold" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f6dc96" />
            <stop offset="0.5" stop-color="#d4a73a" />
            <stop offset="1" stop-color="#9c7419" />
          </linearGradient>
          <linearGradient id="m-sweep" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="0.5" stop-color="#fff" stop-opacity="0.85" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <clipPath id="m-clip"><circle cx={C} cy={C} r="178" /></clipPath>
        </defs>

        <!-- design: the sketch -->
        <g class="m-sketch" fill="none" stroke="var(--silver-soft)" stroke-width="0.8">
          <circle cx={C} cy={C} r="166" pathLength="1" stroke-dasharray="0.012 0.008" />
          <circle cx={C} cy={C} r="150" pathLength="1" />
          <circle cx={C} cy={C} r="44" pathLength="1" />
          <line x1={C - 186} y1={C} x2={C + 186} y2={C} pathLength="1" />
          <line x1={C} y1={C - 186} x2={C} y2={C + 186} pathLength="1" />
          {petals.map((d) => <path d={d} pathLength="1" />)}
        </g>

        <!-- weight: a fine scale line across the drawing -->
        <g class="m-scale" stroke="var(--brass-soft)" stroke-width="0.8">
          <line x1="14" y1="388" x2="386" y2="388" pathLength="1" />
          {Array.from({ length: 13 }, (_, i) => (
            <line x1={14 + i * 31} y1={i % 3 ? 384 : 380} x2={14 + i * 31} y2="388" />
          ))}
        </g>

        <!-- gold in: grains fly to the rim -->
        <g class="m-grains" fill="url(#m-gold)">
          {grains.map((g) => (
            <circle cx={f(g.x)} cy={f(g.y)} r="3.6" style={`--dx:${f(g.dx)}px;--dy:${f(g.dy)}px;--k:${g.k.toFixed(3)}`} />
          ))}
        </g>

        <!-- ghaat: the gold framework -->
        <g class="m-frame" fill="none" stroke="url(#m-gold)" stroke-linecap="round" stroke-linejoin="round">
          <circle cx={C} cy={C} r="150" stroke-width="5" pathLength="1" />
          <path d={scallop} stroke-width="3.2" pathLength="1" />
          <circle cx={C} cy={C} r="122" stroke-width="2" pathLength="1" />
          {petals.map((d) => <path d={d} stroke-width="3.4" pathLength="1" />)}
          <circle cx={C} cy={C} r="44" stroke-width="4" pathLength="1" />
        </g>

        <!-- kundan setting: the stones -->
        <g class="m-stones">
          <g class="m-stone" style="--s:0">
            <circle cx={C} cy={C} r="32" fill="url(#m-polki)" stroke="url(#m-gold)" stroke-width="3" />
            <circle cx={C - 9} cy={C - 11} r="5" fill="#fff" opacity="0.9" />
          </g>
          {allStones.map((s, i) => (
            <g class="m-stone" style={`--s:${((i + 1) / (allStones.length + 1)).toFixed(3)}`}>
              {s.kind === 'petal' ? (
                <ellipse cx={f(s.x)} cy={f(s.y)} rx="10" ry="17" transform={`rotate(${f((s as any).rot)} ${f(s.x)} ${f(s.y)})`}
                  fill={`url(#m-${(s as any).tone})`} stroke="url(#m-gold)" stroke-width="2.4" />
              ) : (
                <circle cx={f(s.x)} cy={f(s.y)} r="7" fill="url(#m-polki)" stroke="url(#m-gold)" stroke-width="2" />
              )}
            </g>
          ))}
        </g>

        <!-- finish: a band of light passes over -->
        <g clip-path="url(#m-clip)" class="m-sweep">
          <rect x="-140" y="-40" width="120" height="480" fill="url(#m-sweep)" transform="rotate(18 200 200)" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .motif { padding-block: var(--section); }
  .motif__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .motif__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }
  .motif__art { width: min(100%, 520px); justify-self: center; overflow: visible; }
  .motif__count { display: none; }
  .motif__steps { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.1rem; }
  .motif__n {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--brass-soft);
  }
  .motif__steps h3 { font-size: var(--step-2); margin-top: 0.2rem; }
  .motif__steps p { color: var(--text-on-ink-muted); margin-top: 0.3rem; }
  .m-scale, .m-grains, .m-sweep { display: none; }

  /* ---------------- pinned, scroll-driven version ---------------- */
  :global(.story) .motif { height: 620svh; padding: 0; }
  :global(.story) .motif__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-block: calc(var(--hdr, 80px) + 1rem) calc(var(--sticky-bar) + 1rem);
  }
  @media (min-width: 900px) {
    :global(.story) .motif__stage { padding-bottom: 1.5rem; }
  }
  :global(.story) .motif__grid { width: 100%; }
  :global(.story) .motif__count {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    color: var(--silver-soft);
    letter-spacing: 0.08em;
  }
  :global(.story) .motif__count b {
    font-weight: 500;
    font-size: clamp(2.6rem, 1.8rem + 3vw, 5.5rem);
    line-height: 0.9;
    color: var(--brass-soft);
    letter-spacing: 0;
  }
  :global(.story) .motif__steps { position: relative; display: block; min-height: 6.5em; margin-top: 1rem; }
  :global(.story) .motif__steps li {
    position: absolute;
    inset: 0 0 auto 0;
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.22, 0.8, 0.24, 1);
  }
  :global(.story) .motif__steps li.is-current { opacity: 1; transform: none; }
  :global(.story) .motif__steps .motif__n { display: none; }

  /* phones: drawing on top, words under it, everything inside one screen */
  @media (max-width: 899px) {
    :global(.story) .motif__grid { gap: 0.75rem; }
    :global(.story) .motif__art {
      order: -1;
      width: min(84vw, calc(100svh - var(--hdr, 150px) - var(--sticky-bar) - 300px));
      min-width: 190px;
    }
    :global(.story) .motif .eyebrow, :global(.story) .motif h2 { display: none; }
    :global(.story) .motif__count { margin-top: 0; }
    :global(.story) .motif__count b { font-size: 2.4rem; }
    :global(.story) .motif__steps { margin-top: 0.4rem; min-height: 7.5em; }
    :global(.story) .motif__steps h3 { font-size: var(--step-1); }
    :global(.story) .motif__steps p { font-size: 0.95rem; }
    :global(.story) .motif .more { display: none; }
  }

  /* ---- the drawing, driven by per-phase variables 0 → 1 ---- */
  :global(.story) .m-sketch > * {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--design, 0));
    opacity: calc(1 - var(--ghaat, 0) * 0.75);
  }
  :global(.story) .m-sketch > circle:first-child { stroke-dasharray: 0.012 0.008; stroke-dashoffset: 0; opacity: calc(var(--design, 0) * (1 - var(--ghaat, 0))); }
  :global(.story) .m-scale { display: inline; opacity: calc(var(--weight, 0) * (1 - var(--goldin, 0))); }
  :global(.story) .m-scale line:first-child { stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--weight, 0)); }
  :global(.story) .m-grains { display: inline; }
  :global(.story) .m-grains circle {
    --g: clamp(0, var(--goldin, 0) * 1.6 - var(--k) * 0.6, 1);
    transform: translate(calc(var(--dx) * (1 - var(--g))), calc(var(--dy) * (1 - var(--g))));
    opacity: clamp(0, var(--goldin, 0) * 5 - var(--k) * 2, 1);
  }
  :global(.story) .m-frame > * {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--ghaat, 0));
  }
  :global(.story) .m-stone {
    --on: clamp(0, var(--setting, 0) * 1.25 - var(--s) * 1.1, 1);
    opacity: var(--on);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(0.3 + var(--on) * 0.7));
  }
  :global(.story) .m-sweep { display: inline; opacity: clamp(0, var(--finish, 0) * 20, 1); }
  :global(.story) .m-sweep rect { transform: rotate(18deg) translateX(calc(var(--finish, 0) * 560px)); transform-origin: 200px 200px; }
  :global(.story) .motif__art {
    filter: drop-shadow(0 0 calc(var(--finish, 0) * 26px) rgba(233, 205, 134, calc(var(--finish, 0) * 0.45)));
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const motifs = Array.from(document.querySelectorAll<HTMLElement>('[data-motif]'));

  if (!reduce && motifs.length) {
    const root = document.documentElement;
    root.classList.add('story');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const header = document.querySelector<HTMLElement>('header');
    const setHdr = () => { if (header) root.style.setProperty('--hdr', `${header.offsetHeight}px`); };
    const PHASES = ['design', 'weight', 'goldin', 'ghaat', 'setting', 'finish'];

    const items = motifs.map((el) => ({
      el,
      art: el.querySelector<SVGElement>('.motif__art')!,
      steps: Array.from(el.querySelectorAll<HTMLElement>('.motif__steps li')),
      count: el.querySelector<HTMLElement>('[data-motif-count]'),
    }));

    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;
      items.forEach(({ el, art, steps, count }) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) return;
        const p = clamp(-r.top / Math.max(r.height - vh, 1));
        // six equal turns, with a short hold at the end on the finished piece
        const n = steps.length, span = 0.92 / n;
        PHASES.forEach((name, i) => {
          art.style.setProperty(`--${name}`, clamp((p - i * span) / (span * 0.85)).toFixed(3));
        });
        const cur = Math.min(n - 1, Math.floor(p / span));
        steps.forEach((li, i) => li.classList.toggle('is-current', i === cur));
        if (count) count.textContent = String(cur + 1).padStart(2, '0');
      });
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => { setHdr(); request(); }, { passive: true });
    setHdr();
    frame();
  }
</script>
