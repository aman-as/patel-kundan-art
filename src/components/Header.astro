---
/**
 * Slim header. Logo on the left; on wide screens the four links and a Call
 * button on the right. On phones: the logo, a Call button and a menu that
 * opens a full-screen sheet. The menu is a <details> element, so it opens and
 * closes with no JavaScript at all.
 */
import Mark from './Mark.astro';
import { site, url, tel, primary, formatPhone } from '../data/site';

const nav = [
  { href: url('/workshop/'), label: 'The Workshop' },
  { href: url('/custom-orders/'), label: 'Custom Orders' },
  { href: url('/for-jewellers/'), label: 'For Jewellers' },
  { href: url('/contact/'), label: 'Contact' },
];
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${site.brand}, home`}>
      <Mark size="34px" decorative />
      <span class="brand__name">{site.brand}</span>
    </a>

    <nav class="desk" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="call" href={tel()}>
      <span class="call__short">Call</span>
      <span class="call__long">Call {formatPhone(primary.number)}</span>
    </a>

    <details class="mob">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <nav class="sheet" aria-label="Main">
        <ul>
          {nav.map((item, i) => (
            <li style={`--i:${i}`}><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
          ))}
        </ul>
        <p class="sheet__addr">{site.address.street}, Karol Bagh, New Delhi</p>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    color: var(--text-on-ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  /* The tint and blur sit on a layer behind the bar, not on the header
     itself: a backdrop-filter on the header would make it the box the
     fixed phone menu is measured against, squeezing the menu into 60px. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(10, 9, 11, 0.92);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    transition: background-color 0.35s ease;
  }
  :global(.site-header.is-stuck)::before { background: rgba(20, 16, 13, 0.9); }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    text-decoration: none;
    color: inherit;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .desk { display: none; }
  .desk ul { display: flex; gap: 2rem; margin: 0; padding: 0; list-style: none; }
  .desk a {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--text-on-ink-muted);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .desk a:hover { color: var(--text-on-ink); }
  .desk a[aria-current='page'] { color: var(--brass-soft); border-bottom-color: var(--brass-soft); }

  .call {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 1rem;
    border: 1px solid rgba(233, 205, 134, 0.55);
    border-radius: 999px;
    color: var(--brass-soft);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .call:hover { background: var(--brass-soft); color: var(--ink); }
  .call__long { display: none; }

  /* ---- phone menu ---- */
  .mob summary {
    list-style: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-content: center;
    gap: 6px;
    cursor: pointer;
  }
  .mob summary::-webkit-details-marker { display: none; }
  .mob summary span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-on-ink);
    transition: transform 0.3s ease;
  }
  .mob[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .mob[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .sheet {
    position: fixed;
    inset: 60px 0 0 0;
    z-index: 70;
    background: var(--ink);
    padding: 2.5rem var(--gutter) calc(var(--sticky-bar) + 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* a sideways phone is shorter than the menu: it scrolls on its own */
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sheet ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .sheet a {
    display: block;
    padding-block: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, min(1.4rem + 3vw, 7svh), 2.8rem);
    line-height: 1.1;
    color: var(--text-on-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink-line);
    animation: sheetIn 0.5s cubic-bezier(0.22, 0.8, 0.24, 1) backwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }
  .sheet a[aria-current='page'] { color: var(--brass-soft); }
  .sheet__addr { font-size: 0.85rem; color: var(--text-on-ink-muted); }
  /* the page behind an open menu stays still */
  @media (max-width: 899px) {
    :global(html:has(details.mob[open])) { overflow: hidden; }
  }
  @keyframes sheetIn {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: none; }
  }

  /* the smallest phones (320px wide) */
  @media (max-width: 359px) {
    .bar { gap: 0.6rem; }
    .brand { gap: 0.45rem; }
    .brand__name { font-size: 1.05rem; }
    .call { padding: 0 0.8rem; }
  }

  @media (min-width: 900px) {
    .bar { height: 72px; gap: 2.5rem; }
    .brand__name { font-size: 1.35rem; }
    .desk { display: block; }
    .mob { display: none; }
    .call__short { display: none; }
    .call__long { display: inline; }
  }
</style>

<script>
  // Escape closes the phone menu and hands focus back to its button
  const menu = document.querySelector<HTMLDetailsElement>('details.mob');
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
