---
/**
 * FILM HERO — the opening chapter.
 *
 * Film A ("From sketch to gold") fills the screen and plays forward as the
 * visitor scrolls, backwards as they scroll up. The headline and buttons sit
 * over it and fade as the gold appears.
 *
 * Until the film exists, `wide`/`tall` are left out and a dark, warm still
 * stands in. The section works the same either way.
 *
 * Files: public/video/<name>.mp4, encoded with a keyframe on every few frames
 * so seeking is instant (see scripts note in the plan). `tall` is used on
 * portrait screens, `wide` everywhere else, and `posterTall` is the tall
 * film's first frame, so a phone opens on the same picture the film starts on.
 */
import Mark from './Mark.astro';
import { url } from '../data/site';

interface Props {
  wide?: string;
  tall?: string;
  poster?: string;
  posterTall?: string;
  /** Short statements that take turns over the film once the headline has
   *  gone, each timed to a stage of it (see `windows` in the script). */
  lines?: string[];
}
const { wide, tall, poster, posterTall, lines = [] } = Astro.props;
const src = (f?: string) => (f ? url(`/video/${f}`) : undefined);
---

<section class="film on-ink" data-film data-wide={src(wide)} data-tall={src(tall)}>
  <div class="film__stage">
    <div class="film__media" aria-hidden="true">
      {wide || tall ? (
        <>
          {/* the opening frame, chosen by the screen's shape without waiting
              for the script; the film covers it once its first frame is in */}
          {poster && (
            <picture>
              {posterTall && <source media="(orientation: portrait)" srcset={url(`/video/${posterTall}`)} />}
              <img class="film__poster" src={url(`/video/${poster}`)} alt="" decoding="async" fetchpriority="high" />
            </picture>
          )}
          <video muted playsinline preload="auto"></video>
        </>
      ) : (
        <div class="film__still">
          <Mark size="min(78vmin, 640px)" color="rgba(233, 205, 134, 0.07)" class="film__mark" />
        </div>
      )}
    </div>
    <div class="film__shade" aria-hidden="true"></div>
    <div class="wrap film__copy enter">
      <slot />
    </div>
    {lines.length > 0 && (
      <ol class="wrap film__lines">
        {lines.map((l) => <li class:list={{ 'is-long': l.length > 24 }}>{l}</li>)}
      </ol>
    )}
    <p class="film__hint" aria-hidden="true">Scroll</p>
  </div>
</section>

<style>
  .film { position: relative; }
  .film__stage {
    position: relative;
    min-height: calc(100svh - 60px);
    display: grid;
    align-items: end;
    overflow: hidden;
  }
  .film__media, .film__shade { position: absolute; inset: 0; }
  /* one fixed frame for the whole scroll: the same size, crop and position
     from the first frame to the last */
  .film__media video,
  .film__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .film__still {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 72% 58%, rgba(214, 170, 48, 0.22), transparent 60%),
      radial-gradient(ellipse 50% 40% at 20% 100%, rgba(233, 205, 134, 0.08), transparent 70%),
      var(--ink);
  }
  .film__still :global(.film__mark) {
    position: absolute;
    right: -8vmin;
    top: 50%;
    transform: translateY(-50%);
  }
  .film__shade {
    background: linear-gradient(to top, rgba(22, 17, 13, 0.92) 0%, rgba(22, 17, 13, 0.5) 38%, transparent 70%);
  }
  /* on a wide screen the words sit on the left, over the bright paper */
  @media (min-width: 800px) {
    .film__shade {
      background:
        linear-gradient(to top, rgba(22, 17, 13, 0.92) 0%, rgba(22, 17, 13, 0.5) 38%, transparent 70%),
        linear-gradient(to right, rgba(22, 17, 13, 0.62) 0%, rgba(22, 17, 13, 0.28) 42%, transparent 66%);
    }
  }
  /* on a phone the words fill the lower two thirds of the screen */
  @media (max-width: 799px) {
    .film__shade {
      background: linear-gradient(to top, rgba(22, 17, 13, 0.94) 0%, rgba(22, 17, 13, 0.72) 45%, rgba(22, 17, 13, 0.3) 72%, transparent 88%);
    }
  }
  .film__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.15rem;
    justify-items: start;
    padding-block: 4rem clamp(3rem, 2rem + 6svh, 6rem);
  }
  .film__copy :global(h1) {
    /* sized by the screen's height too, so a short or sideways phone still
       shows the buttons */
    font-size: clamp(2.9rem, min(1.6rem + 6.4vw, 14svh), 7rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 12ch;
  }
  .film__copy :global(.lede) { max-width: 44ch; color: var(--silver-soft); }
  /* the film opens on cream paper, where gold and silver type wash out */
  .film__copy :global(.eyebrow),
  .film__copy :global(.lede),
  .film__copy :global(h1) { text-shadow: 0 1px 14px rgba(22, 17, 13, 0.75), 0 0 2px rgba(22, 17, 13, 0.5); }
  .film__hint { display: none; }

  /* a phone: the words are set a size smaller and closer together so they fit
     between the header and the call bar, and they always start at least 20px
     below the 60px header, even on a screen they fill */
  @media (max-width: 799px) {
    .film__copy {
      gap: clamp(0.5rem, 1.2svh, 0.8rem);
      padding-top: calc(60px + 20px);
      padding-bottom: calc(var(--sticky-bar) + 1rem);
    }
    .film__copy :global(.eyebrow) {
      font-size: 0.72rem;
      line-height: 1.4;
      letter-spacing: 0.1em;
    }
    .film__copy :global(h1) {
      font-size: clamp(2.25rem, 8.5vw, 3.1rem);
      line-height: 0.98;
    }
    .film__copy :global(.lede) {
      font-size: clamp(0.92rem, 3.7vw, 1rem);
      line-height: 1.42;
    }
  }

  /* without the scroll story the statements are a plain list under the film */
  .film__lines {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 2.5rem 0;
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 3vw, 4rem);
    line-height: 1.05;
    color: var(--brass-soft);
  }

  /* ---------------- pinned, scroll-driven version ---------------- */
  /* The header is sticky, so once the stage pins it sits under the header.
     Pull the section up by the header's height so it starts there on load
     too; otherwise the bottom of the stage (and the hero's Call button) starts
     below the fold, behind the phone call bar. */
  :global(.story) .film { height: 420svh; margin-top: -60px; }
  @media (min-width: 900px) {
    :global(.story) .film { margin-top: -72px; }
  }
  :global(.story) .film:not([data-wide]):not([data-tall]) { height: 150svh; }
  :global(.story) .film__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }
  :global(.story) .film__copy {
    padding-bottom: calc(var(--sticky-bar) + 2.5rem);
    opacity: calc(1 - clamp(0, (var(--p, 0) - 0.06) * 7, 1));
    transform: translate3d(0, calc(var(--p, 0) * -160px), 0);
  }
  :global(.story) .film__copy.is-gone { visibility: hidden; }

  /* the statements sit where the headline was, one at a time */
  :global(.story) .film__lines {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    height: 100%;
    padding: 0;
    pointer-events: none;
    font-size: clamp(2.7rem, 1.2rem + 5.4vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  :global(.story) .film__lines li {
    position: absolute;
    /* the list already sits on the page's margins, so the words line up
       with the headline */
    inset-inline: 0;
    bottom: calc(var(--sticky-bar) + 3rem);
    max-width: 11ch;
    color: #f4ead2;
    text-shadow: 0 2px 24px rgba(22, 17, 13, 0.8), 0 0 2px rgba(22, 17, 13, 0.5);
    opacity: var(--a, 0);
    transform: translate3d(0, calc((1 - var(--a, 0)) * 28px), 0);
    filter: blur(calc((1 - var(--a, 0)) * 6px));
  }
  /* a longer statement takes three even lines on a phone rather than four */
  :global(.story) .film__lines li.is-long { max-width: 14ch; text-wrap: balance; }
  @media (min-width: 800px) {
    :global(.story) .film__lines li {
      bottom: clamp(3rem, 2rem + 8svh, 7rem);
      max-width: none;
      white-space: nowrap;
    }
    /* one line where it fits; a longer statement breaks into two even lines
       rather than running off the screen */
    :global(.story) .film__lines li.is-long { max-width: none; white-space: normal; }
  }
  @media (min-width: 800px) {
    :global(.story) .film__copy { padding-bottom: clamp(3rem, 2rem + 8svh, 7rem); }
  }
  @media (max-width: 799px) {
    :global(.story) .film__copy { padding-bottom: calc(var(--sticky-bar) + 1rem); }
  }
  :global(.story) .film__shade { opacity: calc(1 - var(--p, 0) * 0.6); }
  :global(.story) .film__still { transform: scale(calc(1 + var(--p, 0) * 0.12)); }
  :global(.story) .film__still :global(.film__mark) {
    opacity: calc(0.6 + var(--p, 0) * 2);
    filter: drop-shadow(0 0 calc(var(--p, 0) * 30px) rgba(233, 205, 134, 0.3));
  }
  :global(.story) .film__hint {
    display: block;
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--sticky-bar) + 1.25rem);
    z-index: 1;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    opacity: calc(1 - var(--p, 0) * 8);
    writing-mode: vertical-rl;
  }
  @media (min-width: 800px) {
    :global(.story) .film__hint { bottom: 2rem; }
  }

  /* a sideways phone: the eyebrow and the lede go, so the headline and both
     buttons still fit above the call bar */
  @media (max-height: 500px) {
    .film__copy :global(.eyebrow), .film__copy :global(.lede) { display: none; }
    .film__copy { gap: 0.8rem; padding-top: 1rem; }
    .film__copy :global(h1) { font-size: clamp(2.2rem, 13svh, 3.4rem); }
    :global(.story) .film__copy { padding-bottom: calc(var(--sticky-bar) + 0.75rem); }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // a phone or tablet, where the film is scrubbed more gently (see `seek`)
  const touch = window.matchMedia('(pointer: coarse)').matches;
  const films = Array.from(document.querySelectorAll<HTMLElement>('[data-film]'));

  films.forEach((el) => {
    const stage = el.querySelector<HTMLElement>('.film__stage');
    const video = el.querySelector<HTMLVideoElement>('video');
    const copy = el.querySelector<HTMLElement>('.film__copy');
    const lines = Array.from(el.querySelectorAll<HTMLElement>('.film__lines li'));
    // when each statement is on screen, as a share of the scroll: over the
    // melting gold, over the ghaat and setting, and over the finished piece
    // (the last one stays as the stage lets go)
    const windows = [[0.22, 0.36], [0.39, 0.6], [0.67, 1.4]];
    // chosen once, by the screen's shape as the page opens, and never changed
    // while scrolling (a phone's toolbars resize the window as it scrolls)
    const portrait = window.matchMedia('(orientation: portrait)').matches;
    const src = (portrait ? el.dataset.tall : el.dataset.wide) || el.dataset.wide || el.dataset.tall;
    if (video && src) video.src = src;

    if (reduce) return; // the still or the poster frame, nothing moves
    document.documentElement.classList.add('story');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const FRAME = 1 / 24; // both films run at 24 frames a second

    let raf = 0, target = 0, shown = 0, unlocking = false;

    // On a desktop every scroll step seeks straight to its frame, as it always
    // has. On a touch screen one seek runs at a time, to a whole frame, and the
    // film eases towards the scroll position, so a flick glides instead of
    // cutting; the next seek waits for the last to land ('seeked' below), so
    // seeks never queue up and frames arrive in order. Returns true while the
    // film is still catching up.
    const seek = () => {
      if (!video || !video.duration || unlocking) return false;
      if (!touch) {
        if (Math.abs(video.currentTime - target) > 0.02) video.currentTime = target;
        return false;
      }
      shown += (target - shown) * 0.35;
      if (Math.abs(target - shown) < FRAME / 2) shown = target;
      if (!video.seeking) {
        const t = Math.min(Math.round(shown / FRAME) * FRAME, video.duration - 0.05);
        if (Math.abs(video.currentTime - t) > FRAME / 2) video.currentTime = t;
      }
      return shown !== target;
    };

    const frame = () => {
      raf = 0;
      const r = el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      // measured against the pinned stage (100svh) rather than the window, so
      // a phone's toolbar sliding in or out does not nudge the film
      const vh = stage?.offsetHeight || window.innerHeight;
      const p = clamp(-r.top / Math.max(r.height - vh, 1));
      el.style.setProperty('--p', p.toFixed(4));
      copy?.classList.toggle('is-gone', p > 0.21);
      lines.forEach((li, i) => {
        const [a, b] = windows[i] ?? [2, 2];
        const edge = (b - a) * 0.25;
        const v = Math.min(clamp((p - a) / edge), clamp((b - p) / edge));
        li.style.setProperty('--a', v.toFixed(3));
      });
      if (video && video.duration) {
        // the film ends a little before the stage lets go, so the last
        // frame (the finished gold) holds for a moment
        target = clamp(p / 0.85) * (video.duration - 0.05);
        if (seek()) request();
      }
    };
    const request = () => { if (!raf) raf = requestAnimationFrame(frame); };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    video?.addEventListener('loadedmetadata', request);
    if (touch) video?.addEventListener('seeked', request);

    // iOS shows no frame for a seek until the video has played once. On the
    // first touch it plays, muted and at a tenth of the speed, and pauses the
    // moment it starts, so the picture does not move; scrubbing waits for that
    // and then lands wherever the scroll has reached. If the play is refused
    // (Low Power Mode), the next touch tries again.
    const unlock = () => {
      if (!video || !video.paused || unlocking) return;
      unlocking = true;
      video.playbackRate = 0.1;
      video.play()
        .then(() => {
          video.pause();
          window.removeEventListener('touchstart', unlock);
        })
        .catch(() => {})
        .finally(() => {
          video.playbackRate = 1;
          unlocking = false;
          request();
        });
    };
    window.addEventListener('touchstart', unlock, { passive: true });
    frame();
  });
</script>
