---
/**
 * STARDUST — the hero animation.
 *
 * 1. Five ribbons of dust sweep in along curved paths, trailing comet tails.
 *    In flight the grains are SILVER.
 * 2. They assemble into the कुंदन वाला mark and turn BOLD GOLD — and stay
 *    bold. Both metals the workshop works in, said without a word of copy.
 * 3. Once formed the mark never goes static: it breathes, and gold vapour
 *    lifts continuously off every edge, drifts outward and fades, like heat
 *    shimmer coming off warm metal.
 *
 * Pointer or finger scatters the grains; they spring back.
 *
 * Drawn on one canvas from the mark's own alpha channel. No video, no image
 * sequence, no animation library.
 *
 * Guards: honours prefers-reduced-motion (draws the settled mark and stops),
 * pauses off-screen and on tab hide, and scales particle count, grain size
 * and pixel ratio to the device.
 */
import mark from '../assets/img/brand/kundanwala-mark.webp';
---

<canvas class="dust" data-mark={mark.src} aria-hidden="true"></canvas>

<style>
  .dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  type P = {
    sx: number; sy: number; cx: number; cy: number;
    tx: number; ty: number; delay: number; dur: number;
    x: number; y: number; vx: number; vy: number;
    s: number; ph: number; band: number; warm: number;
  };
  type V = {
    x: number; y: number; vx: number; vy: number;
    life: number; max: number; s: number;
  };

  const INK = '10, 9, 11';
  const SILVER: [number, number, number] = [214, 221, 230];
  const GOLD: [number, number, number] = [214, 170, 48];
  const GOLD_HI: [number, number, number] = [246, 222, 154];
  const STEPS = 8;
  // Settled grains are bold. The dimmest band used to sit at 0.42, which is
  // what made the assembled mark look faded next to the bright flight.
  const BAND_A = [0.72, 0.9, 1.0];
  const VAPOUR_STEPS = 5;

  const ease = (t: number) => 1 - Math.pow(1 - t, 4);
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;

  document.querySelectorAll<HTMLCanvasElement>('canvas.dust').forEach((canvas) => {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const host = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;

    const RAMP: string[][] = [];
    for (let w = 0; w < STEPS; w++) {
      const t = w / (STEPS - 1);
      const row: string[] = [];
      for (let b = 0; b < 3; b++) {
        const target = b === 2 ? GOLD_HI : GOLD;
        const r = Math.round(mix(SILVER[0], target[0], t));
        const g = Math.round(mix(SILVER[1], target[1], t));
        const bl = Math.round(mix(SILVER[2], target[2], t));
        row.push(`rgba(${r},${g},${bl},${BAND_A[b]})`);
      }
      RAMP.push(row);
    }
    const VAP: string[] = [];
    for (let i = 0; i < VAPOUR_STEPS; i++) {
      VAP.push(`rgba(${GOLD_HI[0]},${GOLD_HI[1]},${GOLD_HI[2]},${(0.1 + (i / (VAPOUR_STEPS - 1)) * 0.5).toFixed(3)})`);
    }

    let W = 0, H = 0, dpr = 1;
    let parts: P[] = [];
    let vap: V[] = [];
    let vapCap = 0;
    let cxm = 0, cym = 0;
    let raf = 0, visible = true, t0 = 0, done = false, doneAt = 0;
    const ptr = { x: -1e4, y: -1e4, on: false };
    const R = coarse ? 80 : 120;
    const PUSH = coarse ? 1.4 : 1.8;

    function build(img: HTMLImageElement) {
      const rect = host.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, W, H);

      // The mark owns the RIGHT of the hero at every width — beside the
      // headline on desktop, and in the free space to the right of the
      // left-aligned text on phones.
      const wide = W >= 900;
      // Desktop: beside the headline. Phones: the upper right, in the gap
      // left by the three short headline lines — the headline never reaches
      // past about half the width, so that block is free.
      const size = wide
        ? Math.min(W * 0.38, H * 0.78, 500)
        : Math.min(W * 0.44, H * 0.29, 182);
      cxm = wide ? W * 0.72 : W * 0.71;
      cym = wide ? H * 0.5 : H * 0.29;

      const off = document.createElement('canvas');
      const ow = Math.round(size), oh = Math.round(size * (img.height / img.width));
      off.width = ow; off.height = oh;
      const octx = off.getContext('2d', { willReadFrequently: true });
      if (!octx) return;
      octx.drawImage(img, 0, 0, ow, oh);

      let data: Uint8ClampedArray;
      try { data = octx.getImageData(0, 0, ow, oh).data; } catch { return; }

      const ox = cxm - ow / 2, oy = cym - oh / 2;
      const gap = W < 700 ? 2 : W < 1200 ? 3 : 2;
      const keep = W < 700 ? 0.8 : 0.5;

      const STREAMS = 5;
      const origins: { x: number; y: number; cx: number; cy: number }[] = [];
      for (let i = 0; i < STREAMS; i++) {
        const a = (-0.55 + (i / (STREAMS - 1)) * 1.9) * Math.PI;
        const far = Math.max(W, H) * 1.05;
        origins.push({
          x: cxm + Math.cos(a) * far,
          y: cym + Math.sin(a) * far * 0.7,
          cx: cxm + Math.cos(a + 1.25) * size * 2.4,
          cy: cym + Math.sin(a + 1.25) * size * 1.7,
        });
      }

      const next: P[] = [];
      for (let y = 0; y < oh; y += gap) {
        for (let x = 0; x < ow; x += gap) {
          const a = data[(y * ow + x) * 4 + 3];
          if (a < 45) continue;
          if (Math.random() > keep) continue;
          const tx = ox + x, ty = oy + y;
          const ang = Math.atan2(ty - cym, tx - cxm);
          let si = Math.floor(((ang + Math.PI) / (Math.PI * 2)) * STREAMS) % STREAMS;
          if (si < 0) si += STREAMS;
          const o = origins[si];
          const j = size * 0.55;
          next.push({
            sx: o.x + (Math.random() - 0.5) * j,
            sy: o.y + (Math.random() - 0.5) * j,
            cx: o.cx + (Math.random() - 0.5) * j * 1.6,
            cy: o.cy + (Math.random() - 0.5) * j * 1.6,
            tx, ty,
            delay: si * 0.13 + Math.random() * 0.85,
            dur: 1.5 + Math.random() * 0.85,
            x: o.x, y: o.y, vx: 0, vy: 0,
            s: coarse ? (Math.random() < 0.15 ? 1.7 : 1.0)
                      : (Math.random() < 0.15 ? 2.4 : 1.4),
            ph: Math.random() * Math.PI * 2,
            band: a > 200 ? 2 : a > 120 ? 1 : 0,
            warm: 0,
          });
        }
      }
      parts = next;
      vap = [];
      vapCap = coarse ? 130 : 260;
      t0 = performance.now();
      done = false;
    }

    /** A grain of vapour lifting off the mark. */
    function spawnVapour() {
      const p = parts[(Math.random() * parts.length) | 0];
      if (!p) return;
      const dx = p.tx - cxm, dy = p.ty - cym;
      const d = Math.hypot(dx, dy) || 1;
      const sp = 0.18 + Math.random() * 0.5;
      vap.push({
        x: p.tx, y: p.ty,
        vx: (dx / d) * sp + (Math.random() - 0.5) * 0.22,
        vy: (dy / d) * sp - 0.14 - Math.random() * 0.16, // slight lift
        life: 0,
        max: 1.7 + Math.random() * 1.7,
        s: 0.8 + Math.random() * 1.5,
      });
    }

    let last = 0;
    function frame(now: number) {
      raf = 0;
      if (!ctx) return;
      const time = (now - t0) / 1000;
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
      last = now;

      if (done) {
        ctx.clearRect(0, 0, W, H);
      } else {
        ctx.fillStyle = `rgba(${INK}, 0.22)`;
        ctx.fillRect(0, 0, W, H);
      }

      // Breathing: the settled mark drifts a couple of pixels on a slow cycle
      // so it is never truly still.
      //
      // Both waves are anchored to the instant it landed and ramped in from
      // zero. Reading them off the absolute clock meant sin() was at some
      // arbitrary value the moment the mark completed, so the whole thing
      // jumped a couple of pixels as it finished. cos() is the worse of the
      // two — it starts at 1, i.e. full offset.
      const sinceDone = done ? time - doneAt : 0;
      const ramp = Math.min(1, sinceDone / 1.8);
      const bx = done ? Math.sin(sinceDone * 0.42) * 2.6 * ramp : 0;
      const by = done ? Math.sin(sinceDone * 0.31) * 2.1 * ramp : 0;

      const buckets: P[][][] = RAMP.map(() => [[], [], []]);
      let travelling = 0;

      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];
        const lt = (time - p.delay) / p.dur;

        if (lt < 1) {
          travelling++;
          if (lt > 0) {
            const e = ease(lt);
            const n = 1 - e;
            p.x = n * n * p.sx + 2 * n * e * p.cx + e * e * p.tx;
            p.y = n * n * p.sy + 2 * n * e * p.cy + e * e * p.ty;
            // Stay silver for most of the run, then turn gold on arrival.
            p.warm = Math.max(0, (e - 0.72) / 0.28);
          } else {
            continue;
          }
        } else {
          p.warm = 1;
          p.vx += (p.tx + bx - p.x) * 0.065;
          p.vy += (p.ty + by - p.y) * 0.065;
          if (ptr.on) {
            const dx = p.x - ptr.x, dy = p.y - ptr.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < R * R && d2 > 0.01) {
              const d = Math.sqrt(d2);
              const f = (1 - d / R) * PUSH;
              p.vx += (dx / d) * f;
              p.vy += (dy / d) * f;
            }
          }
          p.vx *= 0.86; p.vy *= 0.86;
          p.x += p.vx; p.y += p.vy;
        }

        const w = Math.min(STEPS - 1, Math.round(p.warm * (STEPS - 1)));
        buckets[w][p.band].push(p);
      }

      if (!done && travelling === 0) { done = true; doneAt = time; }

      for (let w = 0; w < STEPS; w++) {
        for (let b = 0; b < 3; b++) {
          const arr = buckets[w][b];
          if (!arr.length) continue;
          ctx.fillStyle = RAMP[w][b];
          for (let i = 0; i < arr.length; i++) {
            const p = arr[i];
            // Twinkle only while the grains are flying. Once landed every
            // grain holds its exact size, so the mark reads as one steady
            // gold — the per-grain size wobble was being seen as the colour
            // still shifting. The vapour supplies the movement instead.
            const tw = done ? 1 : 1 + Math.sin(time * 2.2 + p.ph) * 0.2;
            ctx.fillRect(p.x, p.y, p.s * tw, p.s * tw);
          }
        }
      }

      // ---- vapour ----
      if (done) {
        const want = Math.min(6, vapCap - vap.length);
        for (let i = 0; i < want; i++) spawnVapour();

        const vb: V[][] = Array.from({ length: VAPOUR_STEPS }, () => []);
        for (let i = vap.length - 1; i >= 0; i--) {
          const v = vap[i];
          v.life += dt;
          if (v.life >= v.max) { vap.splice(i, 1); continue; }
          v.x += v.vx; v.y += v.vy;
          v.vx *= 0.994; v.vy *= 0.994;
          v.vy -= 0.0016;                       // keeps rising as it thins
          const k = 1 - v.life / v.max;         // 1 -> 0
          vb[Math.min(VAPOUR_STEPS - 1, (k * VAPOUR_STEPS) | 0)].push(v);
        }
        for (let i = 0; i < VAPOUR_STEPS; i++) {
          if (!vb[i].length) continue;
          ctx.fillStyle = VAP[i];
          for (const v of vb[i]) {
            const k = 1 - v.life / v.max;
            const s = v.s * (0.45 + k * 0.55);
            ctx.fillRect(v.x, v.y, s, s);
          }
        }
      }

      if (visible) raf = requestAnimationFrame(frame);
    }

    function still() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      for (let b = 0; b < 3; b++) {
        ctx.fillStyle = RAMP[STEPS - 1][b];
        for (const p of parts) if (p.band === b) ctx.fillRect(p.tx, p.ty, p.s, p.s);
      }
    }

    function start() {
      if (reduce) { still(); return; }
      if (!raf) { last = 0; raf = requestAnimationFrame(frame); }
    }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

    const track = (cx: number, cy: number) => {
      const r = host.getBoundingClientRect();
      ptr.x = cx - r.left; ptr.y = cy - r.top; ptr.on = true;
    };
    host.addEventListener('pointermove', (e) => track(e.clientX, e.clientY), { passive: true });
    host.addEventListener('pointerleave', () => { ptr.on = false; }, { passive: true });
    host.addEventListener('touchmove', (e) => {
      const t = e.touches[0]; if (t) track(t.clientX, t.clientY);
    }, { passive: true });
    host.addEventListener('touchend', () => { ptr.on = false; }, { passive: true });

    const img = new Image();
    img.decoding = 'async';
    img.src = canvas.dataset.mark!;
    const boot = () => { build(img); start(); };
    if (img.complete) boot(); else img.onload = boot;

    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => { stop(); build(img); start(); }, 180);
    });

    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      visible ? start() : stop();
    }, { threshold: 0.02 }).observe(host);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : (visible && start());
    });
  });
</script>
