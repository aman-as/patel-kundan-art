---
/**
 * GOLD DUST — the hero animation.
 *
 * Thousands of gold particles converge to form the कुंदन वाला mark, then hold
 * with a slow shimmer. Pointer or touch pushes them apart; they spring back.
 * Everything is drawn on one canvas from the mark's own alpha channel — no
 * video, no image sequence, no animation library.
 *
 * Guards: honours prefers-reduced-motion (renders the settled state and
 * stops), pauses when scrolled out of view or the tab is hidden, and scales
 * particle count and pixel ratio to the device.
 */
import mark from '../assets/img/brand/kundanwala-mark.webp';
---

<canvas class="dust" data-mark={mark.src} aria-hidden="true"></canvas>

<style>
  .dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  type P = {
    x: number; y: number; tx: number; ty: number;
    vx: number; vy: number; s: number; ph: number; band: number;
  };

  const BANDS = ['#8A6A28', '#B8933F', '#E3C889'];
  const SPARK = '#F3E3BC';

  document.querySelectorAll<HTMLCanvasElement>('canvas.dust').forEach((canvas) => {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const host = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;

    let W = 0, H = 0, dpr = 1;
    let parts: P[] = [];
    let sparks: P[] = [];
    let raf = 0;
    let visible = true;
    let settled = 0;
    let t0 = 0;

    const ptr = { x: -1e4, y: -1e4, on: false };
    const R = coarse ? 90 : 130;      // interaction radius
    const PUSH = coarse ? 1.5 : 1.9;  // repulsion strength

    /* ---- build particle targets from the mark's alpha channel ---- */
    function build(img: HTMLImageElement) {
      const rect = host.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, coarse ? 2 : 2);

      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      // The mark sits BEHIND the headline column, not beside it — on wide
      // screens the right half is occupied by the product photograph, and
      // anything drawn there is simply covered up.
      // On phones the mark takes the empty band above the headline instead of
      // sitting behind it — overlaying dust on body text is unreadable at that
      // width no matter how the scrim is tuned.
      const wide = W >= 900;
      const size = wide
        ? Math.min(W * 0.54, H * 0.96, 720)
        : Math.min(W * 0.74, H * 0.30, 340);
      const ox = (wide ? W * 0.30 : W * 0.5) - size / 2;
      const oy = wide ? H / 2 - size / 2 : H * 0.045;

      const off = document.createElement('canvas');
      const ow = Math.round(size), oh = Math.round(size * (img.height / img.width));
      off.width = ow; off.height = oh;
      const octx = off.getContext('2d', { willReadFrequently: true });
      if (!octx) return;
      octx.drawImage(img, 0, 0, ow, oh);

      let data: Uint8ClampedArray;
      try {
        data = octx.getImageData(0, 0, ow, oh).data;
      } catch {
        return; // tainted canvas — bail out silently, hero still looks fine
      }

      // Gap controls density. Larger gap on small screens keeps phones smooth.
      const gap = W < 700 ? 3 : W < 1200 ? 4 : 3;
      const next: P[] = [];
      const yOff = oy + (size - oh) / 2;

      for (let y = 0; y < oh; y += gap) {
        for (let x = 0; x < ow; x += gap) {
          const a = data[(y * ow + x) * 4 + 3];
          if (a < 45) continue;
          if (Math.random() > (W < 700 ? 0.97 : 0.92)) continue; // less mechanical
          const tx = ox + x, ty = yOff + y;
          next.push({
            x: tx + (Math.random() - 0.5) * W * 1.4,
            y: ty + (Math.random() - 0.5) * H * 1.6,
            tx, ty,
            vx: 0, vy: 0,
            s: coarse ? (Math.random() < 0.14 ? 1.8 : 1.05)
                      : (Math.random() < 0.14 ? 2.6 : 1.5),
            ph: Math.random() * Math.PI * 2,
            band: a > 200 ? 2 : a > 120 ? 1 : 0,
          });
        }
      }

      parts = next;
      sparks = [];
      for (let i = 0; i < Math.min(46, Math.floor(parts.length / 70)); i++) {
        sparks.push(parts[Math.floor(Math.random() * parts.length)]);
      }
      settled = 0;
      t0 = performance.now();
    }

    /* ---- frame ---- */
    function frame(now: number) {
      raf = 0;
      if (!ctx) return;
      const time = (now - t0) / 1000;
      settled = Math.min(1, time / 1.6);
      const ease = 0.020 + settled * 0.045;

      ctx.clearRect(0, 0, W, H);

      const buckets: P[][] = [[], [], []];
      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];

        // spring toward the mark
        p.vx += (p.tx - p.x) * ease;
        p.vy += (p.ty - p.y) * ease;

        // pointer repulsion
        if (ptr.on) {
          const dx = p.x - ptr.x, dy = p.y - ptr.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < R * R && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const f = (1 - d / R) * PUSH;
            p.vx += (dx / d) * f;
            p.vy += (dy / d) * f;
          }
        }

        p.vx *= 0.855;
        p.vy *= 0.855;
        p.x += p.vx;
        p.y += p.vy;

        buckets[p.band].push(p);
      }

      // Drawn in three tonal bands so the mark reads as depth rather than a
      // flat stencil — and so fillStyle changes three times a frame, not
      // thousands.
      const shimmer = 0.95 + Math.sin(time * 1.1) * 0.07;
      for (let b = 0; b < 3; b++) {
        ctx.fillStyle = BANDS[b];
        ctx.globalAlpha = Math.min(1, settled * shimmer * (0.50 + b * 0.26));
        const arr = buckets[b];
        for (let i = 0; i < arr.length; i++) {
          const p = arr[i];
          const tw = 1 + Math.sin(time * 2.1 + p.ph) * 0.22;
          ctx.fillRect(p.x, p.y, p.s * tw, p.s * tw);
        }
      }

      // a handful of brighter grains that catch the light
      ctx.globalAlpha = settled;
      ctx.fillStyle = SPARK;
      for (let i = 0; i < sparks.length; i++) {
        const p = sparks[i];
        const tw = Math.max(0, Math.sin(time * 1.6 + p.ph));
        if (tw < 0.55) continue;
        const s = 1.6 + tw * 1.9;
        ctx.globalAlpha = settled * (tw - 0.5) * 1.5;
        ctx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
      }
      ctx.globalAlpha = 1;

      if (visible) raf = requestAnimationFrame(frame);
    }

    function still() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      for (let b = 0; b < 3; b++) {
        ctx.fillStyle = BANDS[b];
        ctx.globalAlpha = 0.55 + b * 0.28;
        for (const p of parts) if (p.band === b) ctx.fillRect(p.tx, p.ty, p.s, p.s);
      }
      ctx.globalAlpha = 1;
    }

    function start() {
      if (reduce) { still(); return; }
      if (!raf) { t0 = performance.now() - settled * 1600; raf = requestAnimationFrame(frame); }
    }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

    /* ---- input ---- */
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      ptr.x = e.clientX - r.left;
      ptr.y = e.clientY - r.top;
      ptr.on = true;
    }, { passive: true });
    host.addEventListener('pointerleave', () => { ptr.on = false; }, { passive: true });
    host.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      if (!t) return;
      const r = host.getBoundingClientRect();
      ptr.x = t.clientX - r.left;
      ptr.y = t.clientY - r.top;
      ptr.on = true;
    }, { passive: true });
    host.addEventListener('touchend', () => { ptr.on = false; }, { passive: true });

    /* ---- lifecycle ---- */
    const img = new Image();
    img.decoding = 'async';
    img.src = canvas.dataset.mark!;
    const boot = () => { build(img); start(); };
    if (img.complete) boot(); else img.onload = boot;

    let rt = 0;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => { stop(); build(img); start(); }, 180);
    });

    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      visible ? start() : stop();
    }, { threshold: 0.02 }).observe(host);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : (visible && start());
    });
  });
</script>
