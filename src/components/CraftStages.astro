---
/**
 * HOW A PIECE IS MADE — the stages a kundan piece can pass through, in
 * order. Which ones a piece needs depends on its design. Each stage is named
 * large in English, with its name in the trade, in Hindi, small underneath as
 * a helper.
 *
 * The English name sits in faint gold and fills with antique gold from the
 * bottom up as its stage scrolls into view, the way gold takes the light. With
 * reduced motion it is gold at once; with JavaScript off it is simply gold.
 *
 * The Devanagari face is a subset of Tiro Devanagari Hindi (SIL Open Font
 * License) holding only the letters these names use. A new name needs the
 * subset cut again with fontTools:
 *   pyftsubset TiroDevanagariHindi-Regular.ttf --text="<every name>" \
 *     --layout-features='*' --flavor=woff2 --no-hinting --desubroutinize
 */
interface Stage {
  /** The stage's name in English, shown large. */
  title: string;
  /** Its name at the bench in Devanagari, shown small. */
  word: string;
  /** The same name in Roman letters. */
  roman: string;
  text: string;
  /** The craftsman this stage belongs to, by tradition. */
  who?: string;
  /** What a buyer can check for at this stage. */
  look?: string;
}
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  stages: Stage[];
  /** The trade's words, explained, under the stages. */
  words?: { term: string; meaning: string }[];
}
const { id, eyebrow, title, lede, stages, words = [] } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, '0');
const total = n(stages.length - 1);
---

<section class="section on-sunk craft" id={id}>
  <div class="wrap">
    <div class="craft__head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {lede && <p class="lede">{lede}</p>}
    </div>

    <ol class="craft__list">
      {stages.map((s, i) => (
        <li class="craft__stage reveal">
          <div class="craft__name">
            <p class="craft__n" aria-hidden="true">{n(i)} <span>/ {total}</span></p>
            <h3 class="craft__title"><span class="visually-hidden">{n(i)}. </span>{s.title}</h3>
            <p class="craft__hi"><span lang="hi">{s.word}</span> <span aria-hidden="true">·</span> <span>{s.roman}</span></p>
          </div>
          <div class="craft__body">
            <p class="craft__text">{s.text}</p>
            {(s.who || s.look) && (
              <dl class="craft__facts">
                {s.who && (<div><dt>Craftsman</dt><dd>{s.who}</dd></div>)}
                {s.look && (<div><dt>Look for</dt><dd>{s.look}</dd></div>)}
              </dl>
            )}
          </div>
        </li>
      ))}
    </ol>

    {words.length > 0 && (
      <div class="craft__words">
        <h3 class="craft__words-h">The words, explained</h3>
        <dl>
          {words.map((w) => (<div><dt>{w.term}</dt><dd>{w.meaning}</dd></div>))}
        </dl>
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  @font-face {
    font-family: 'Tiro Devanagari Hindi';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('../assets/fonts/tiro-devanagari-hindi-names.woff2') format('woff2');
    unicode-range: U+0900-097F, U+200C-200D, U+25CC;
  }

  .craft__head { display: grid; gap: 1.1rem; max-width: 760px; }


  .craft__list {
    list-style: none;
    margin: clamp(2.5rem, 2rem + 3vw, 4.5rem) 0 0;
    padding: 0;
  }
  .craft__stage {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(2rem, 1.6rem + 2vw, 3.5rem);
    border-top: 1px solid var(--ivory-line);
  }
  .craft__stage:last-child { border-bottom: 1px solid var(--ivory-line); }

  /* ---- the name: faint gold, then gilded; its trade name small beneath ---- */
  .craft__name { display: grid; justify-items: start; gap: 0.45rem; }
  .craft__title {
    font-size: clamp(3.1rem, 2.4rem + 2.8vw, 5rem);
    line-height: 1.1;
    /* room for the descenders, which the clipped gold would otherwise cut off */
    padding-bottom: 0.08em;
    color: transparent;
    background-image: linear-gradient(180deg, #9a7526 0%, #7a5a12 55%, #5e440d 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* the gold rises through the dim letters */
  :global(.js) .craft__title {
    background-image:
      linear-gradient(180deg, #9a7526 0%, #7a5a12 55%, #5e440d 100%),
      linear-gradient(rgba(122, 90, 18, 0.2), rgba(122, 90, 18, 0.2));
    background-repeat: no-repeat;
    background-position: 0 100%, 0 0;
    background-size: 100% 0%, 100% 100%;
    transition: background-size 1.6s cubic-bezier(0.22, 0.8, 0.24, 1) 0.25s;
  }
  :global(.js) .craft__stage.is-visible .craft__title { background-size: 100% 100%, 100% 100%; }

  .craft__hi {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--silver);
  }
  .craft__hi [lang='hi'] {
    font-family: 'Tiro Devanagari Hindi', 'Noto Serif Devanagari', 'Kohinoor Devanagari', 'Nirmala UI', serif;
    font-size: 1.3rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--brass);
  }
  .craft__hi [aria-hidden] { color: var(--silver); }

  /* ---- the words ---- */
  .craft__n {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--brass);
  }
  .craft__n span { color: var(--silver); }
  .craft__text { color: var(--text-muted); max-width: 56ch; }
  .craft__facts {
    display: grid;
    gap: 0.9rem;
    margin: 1.4rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ivory-line);
    max-width: 56ch;
  }
  .craft__facts dt {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .craft__facts dd { margin: 0.2rem 0 0; font-size: 0.95rem; color: var(--text); }

  /* ---- the trade's words, explained ---- */
  .craft__words { margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); max-width: 980px; }
  .craft__words-h {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .craft__words dl { display: grid; gap: 1.1rem 2.5rem; margin: 1.25rem 0 0; }
  .craft__words dt { font-family: var(--font-display); font-size: var(--step-2); color: var(--text); }
  .craft__words dd { margin: 0.2rem 0 0; color: var(--text-muted); max-width: 46ch; }

  @media (min-width: 640px) {
    .craft__facts { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .craft__words dl { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 900px) {
    .craft__stage {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 2rem + 3vw, 5rem);
      align-items: start;
    }
    .craft__name { position: sticky; top: 22vh; }
    /* the text starts level with the large name, not with the number above it */
    .craft__body { padding-top: 2.1rem; }
  }
</style>
