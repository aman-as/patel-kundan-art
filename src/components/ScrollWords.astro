---
/**
 * SCROLL WORDS — giant type, pinned, Apple-style.
 *
 * The stage holds still while short statements take turns in very large
 * type: each one grows into place, a gold sheen runs across it, and it blurs
 * away for the next. The last word then rushes towards the visitor until they
 * pass through it into the next section.
 *
 * Writes --t on each line (0 → 1 across its own turn) and --fly on the stage;
 * the look is in the styles below. With JavaScript off or reduced motion
 * requested (no .story class), it is a short, static list of statements.
 */
interface Props {
  lines: string[];
  /** Optional word the visitor flies through at the end. Without it the
   *  last statement simply stays on screen as the stage lets go. */
  finale?: string;
}
const { lines, finale } = Astro.props;
---

<section class="words on-ink" data-words data-finale={finale ? '' : undefined} aria-label={[...lines, finale].filter(Boolean).join(' ')}>
  <div class="words__stage">
    <div class="words__glow" aria-hidden="true"></div>
    <ol class="words__lines" aria-hidden="true">
      {lines.map((l) => <li><span>{l}</span></li>)}
      {finale && <li class="words__finale"><span>{finale}</span></li>}
    </ol>
  </div>
</section>

<style>
  .words {
    padding-block: var(--section);
    border-top: 1px solid var(--ink-line);
    /* clip, not hidden: hidden would make this the scroll box and stop the
       stage inside from pinning */
    overflow: clip;
  }
  .words__lines {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--gutter);
    max-width: 1100px;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.05;
    text-align: center;
  }
  .words__lines span {
    background: linear-gradient(100deg, var(--silver-soft) 0%, #fff 30%, var(--brass-soft) 55%, #b8902f 75%, var(--silver-soft) 100%);
    background-size: 260% 100%;
    background-position: calc(100% - var(--t, 0.5) * 100%) 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .words__finale { font-size: 1.6em; }

  /* ---------------- pinned, scroll-driven version ---------------- */
  :global(.story) .words { height: 520svh; padding: 0; border: 0; }
  :global(.story) .words:not([data-finale]) { height: 380svh; }
  :global(.story) .words__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  :global(.story) .words__lines {
    position: absolute;
    inset: 0;
    max-width: none;
    padding: 0;
    display: block;
    font-size: clamp(2.6rem, 1.2rem + 7vw, 8.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  :global(.story) .words__lines li {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--hdr, 80px) var(--gutter) 0;
    /* in for the first fifth of its turn, out for the last */
    --in: clamp(0, var(--t, 0) * 5, 1);
    --out: clamp(0, (var(--t, 0) - 0.8) * 5, 1);
    opacity: calc(var(--in) - var(--out));
    transform: translate3d(0, calc((1 - var(--in)) * 0.35em), 0)
               scale(calc(0.86 + var(--t, 0) * 0.2));
    filter: blur(calc((1 - var(--in) + var(--out)) * 10px));
    will-change: transform, opacity, filter;
  }
  :global(.story) .words__lines li > span { max-width: 13ch; }
  /* the finale grows huge and the visitor passes through it */
  :global(.story) .words__lines .words__finale {
    font-size: 1.5em;
    opacity: calc(var(--in) * (1 - clamp(0, (var(--fly, 0) - 0.55) * 2.6, 1)));
    transform: scale(calc(0.9 + var(--in) * 0.1 + var(--fly, 0) * var(--fly, 0) * var(--fly, 0) * 26));
    filter: blur(calc((1 - var(--in)) * 10px + var(--fly, 0) * 4px));
  }
  :global(.story) .words__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 50% 55%, rgba(233, 205, 134, 0.22), transparent 55%);
    opacity: calc(0.35 + var(--fly, 0) * 0.65);
    transform: scale(calc(0.8 + var(--fly, 0) * 0.8));
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-words]'));

  if (!reduce && blocks.length) {
    const root = document.documentElement;
    root.classList.add('story');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const header = document.querySelector<HTMLElement>('header');
    const setHdr = () => { if (header) root.style.setProperty('--hdr', `${header.offsetHeight}px`); };
    const items = blocks.map((el) => ({
      el,
      finale: el.hasAttribute('data-finale'),
      stage: el.querySelector<HTMLElement>('.words__stage')!,
      lines: Array.from(el.querySelectorAll<HTMLElement>('.words__lines li')),
    }));

    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;
      items.forEach(({ el, stage, lines, finale }) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) return;
        const p = clamp(-r.top / Math.max(r.height - vh, 1));
        if (!finale) {
          // statements share the whole run; the last one stays once it is up
          const n = lines.length, span = 0.94 / n;
          lines.forEach((li, i) => {
            let t = clamp((p - i * span) / span);
            if (i === 0 && p < span * 0.2) t = Math.max(t, 0.2);
            if (i === n - 1) t = Math.min(t, 0.6);
            li.style.setProperty('--t', t.toFixed(3));
          });
          return;
        }
        // statements share the first 72%; the finale arrives just after,
        // holds, and the last 20% is the fly-through
        const n = lines.length - 1, span = 0.72 / n;
        lines.forEach((li, i) => {
          if (i < n) {
            let t = clamp((p - i * span) / span);
            if (i === 0 && p < span * 0.2) t = Math.max(t, 0.2); // already up on arrival
            li.style.setProperty('--t', t.toFixed(3));
          } else {
            li.style.setProperty('--t', clamp((p - 0.71) / 0.06 * 0.2).toFixed(3));
          }
        });
        stage.style.setProperty('--fly', clamp((p - 0.8) / 0.2).toFixed(3));
      });
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => { setHdr(); request(); }, { passive: true });
    setHdr();
    frame();
  }
</script>
