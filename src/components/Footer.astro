---
/**
 * Quiet footer: the mark, the address and the two numbers. No email or
 * Instagram — the standing rule (19 Sep 2026) keeps both off printed and
 * public collateral.
 */
import Mark from './Mark.astro';
import { site, contacts, formatPhone, tel } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="sign">
      <Mark size="64px" decorative />
      <div>
        <p class="name">{site.brand}</p>
        <p class="muted">Kundan jewellery manufacturing<br />Gold &amp; silver, by hand</p>
      </div>
    </div>

    <div>
      <h2 class="h">Workshop</h2>
      <address class="muted">
        {site.address.street}<br />
        {site.address.locality}<br />
        {site.address.city} {site.address.postalCode}
      </address>
      <p class="maps"><a class="link" href={site.mapsUrl} rel="noopener" target="_blank">Open in Google Maps</a></p>
    </div>

    <div>
      <h2 class="h">Call or WhatsApp</h2>
      <ul class="list">
        {contacts.map((c) => (
          <li>
            <a class="num" href={tel(c.number)}>{formatPhone(c.number)}</a>
            <span class="muted">{c.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>{site.entities.join(' · ')} · Karol Bagh, New Delhi</p>
    <p>© {year} {site.brand}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--text-on-ink);
    border-top: 1px solid var(--ink-line);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
  }
  .grid { display: grid; gap: 2.5rem; }
  @media (min-width: 760px) {
    .grid { grid-template-columns: 1.3fr 1fr 1fr; gap: 3rem; }
  }
  .sign { display: flex; gap: 1.1rem; align-items: center; }
  .name { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; }
  .h {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-soft);
    margin-bottom: 0.9rem;
  }
  .muted { color: var(--text-on-ink-muted); font-size: 0.92rem; font-style: normal; line-height: 1.6; }
  .maps { margin-top: 0.75rem; font-size: 0.92rem; }
  .link { color: var(--text-on-ink); text-decoration: none; border-bottom: 1px solid var(--ink-line); }
  .link:hover { border-bottom-color: var(--brass-soft); }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }
  .list li { display: grid; gap: 0.1rem; }
  .num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--text-on-ink);
    text-decoration: none;
  }
  .num:hover { color: var(--brass-soft); }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink-line);
    font-size: 0.8rem;
    color: var(--text-on-ink-muted);
  }
</style>
