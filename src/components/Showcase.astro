---
/**
 * SHOWCASE — the Apple-style pinned zoom.
 *
 * The section is several screens tall; inside it the stage stays pinned while
 * the visitor scrolls. The photograph starts close in on the centre stone and
 * pulls back until the whole set is in view, and three short lines take turns
 * on screen over it. Scroll position drives everything, so it runs as fast or
 * as slow as the visitor reads, and backwards too.
 *
 * Writes one CSS variable (--p, 0 → 1) on the section and --o on each line;
 * the look is in the styles below. With JavaScript off or reduced motion
 * requested (no .story class), it is a plain photograph with the lines under it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Where the zoom starts, as a CSS transform-origin (the detail to open on). */
  focus?: string;
  lines: string[];
}
const { image, alt, focus = '50% 20%', lines } = Astro.props;
---

<section class="showcase on-ink" data-showcase style={`--focus:${focus}`}>
  <div class="showcase__stage">
    <div class="showcase__media">
      <Image
        src={image}
        alt={alt}
        widths={[480, 760, image.width]}
        sizes="(min-width: 900px) 60vw, 100vw"
        format="webp"
        quality={86}
        loading="lazy"
        decoding="async"
      />
    </div>
    <ol class="showcase__lines">
      {lines.map((l, i) => (
        <li class={i === lines.length - 1 ? 'is-last' : ''}>{l}</li>
      ))}
    </ol>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    padding-block: var(--section);
    border-top: 1px solid var(--ink-line);
  }
  .showcase__stage {
    display: grid;
    gap: 2rem;
    justify-items: center;
    padding-inline: var(--gutter);
  }
  .showcase__media {
    width: min(100%, 560px);
    aspect-ratio: 954 / 1183;
  }
  .showcase__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .showcase__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.12;
    color: var(--text-on-ink);
  }
  .showcase__lines .is-last { color: var(--brass-soft); }

  /* ---------------- pinned, scroll-driven version ---------------- */
  :global(.story) .showcase {
    height: 340svh;
    padding: 0;
  }
  :global(.story) .showcase__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: block;
    padding: 0;
  }
  :global(.story) .showcase__media {
    position: absolute;
    left: 50%;
    top: 50%;
    width: auto;
    height: min(86svh, 150vw);
    /* opens close on the detail, pulls back to the whole set by 75% */
    transform: translate(-50%, -50%)
               scale(calc(1 + (1 - var(--z, 1)) * 1.1));
    transform-origin: var(--focus);
    will-change: transform;
  }
  :global(.story) .showcase__media :global(img) {
    /* a touch of warmth comes up as the piece is revealed */
    filter: brightness(calc(0.72 + var(--z, 1) * 0.28)) saturate(calc(0.9 + var(--z, 1) * 0.15));
  }
  /* soft vignette so the words always sit on dark */
  :global(.story) .showcase__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 45%, transparent 40%, rgba(10, 9, 11, 0.75) 100%),
      linear-gradient(to top, rgba(10, 9, 11, 0.85) 0%, transparent 38%);
  }
  :global(.story) .showcase__lines {
    position: absolute;
    inset: auto 0 calc(var(--sticky-bar) + 6svh) 0;
    z-index: 1;
    display: block;
    height: 3.6em;
    padding-inline: var(--gutter);
    font-size: clamp(2rem, 1.4rem + 3.2vw, 4.4rem);
  }
  @media (min-width: 900px) {
    :global(.story) .showcase__lines { bottom: 8svh; }
  }
  :global(.story) .showcase__lines li {
    position: absolute;
    inset: 0 var(--gutter);
    display: grid;
    align-items: end;
    justify-content: center;
    opacity: var(--o, 0);
    transform: translate3d(0, calc((1 - var(--o, 0)) * 0.5em), 0) scale(calc(0.94 + var(--o, 0) * 0.06));
    filter: blur(calc((1 - var(--o, 0)) * 6px));
    will-change: opacity, transform;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shows = Array.from(document.querySelectorAll<HTMLElement>('[data-showcase]'));

  if (!reduce && shows.length) {
    document.documentElement.classList.add('story');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const items = shows.map((s) => ({
      el: s,
      media: s.querySelector<HTMLElement>('.showcase__media')!,
      lines: Array.from(s.querySelectorAll<HTMLElement>('.showcase__lines li')),
    }));

    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;
      items.forEach(({ el, media, lines }) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) return;
        // 0 when the stage pins, 1 when it lets go
        const p = clamp(-r.top / Math.max(r.height - vh, 1));
        media.style.setProperty('--z', ease(clamp(p / 0.75)).toFixed(4));
        // each line gets an equal slice and fades in and out within it;
        // the last one stays once it arrives
        const n = lines.length;
        lines.forEach((li, i) => {
          const a = i / n, b = (i + 1) / n, w = 0.07;
          let o = clamp((p - a) / w) * clamp((b - p) / w);
          if (i === n - 1) o = clamp((p - a) / w);
          if (i === 0 && p < w) o = 1; // the first line is already there on arrival
          li.style.setProperty('--o', o.toFixed(3));
        });
      });
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    frame();
  }
</script>
