---
/**
 * WORD RAIL — what we make, as giant words sliding sideways.
 *
 * The stage pins and a single line of very large words glides from right to
 * left as the visitor scrolls down. Words are drawn in outline; the one
 * passing the middle of the screen fills with gold.
 *
 * With JavaScript off or reduced motion requested (no .story class), the
 * words are an ordinary wrapping list.
 */
interface Props {
  words: string[];
  eyebrow: string;
  title: string;
}
const { words, eyebrow, title } = Astro.props;
---

<section class="rail on-ink" data-rail>
  <div class="rail__stage">
    <div class="wrap">
      <p class="eyebrow">{eyebrow}</p>
      <h2 set:html={title} />
    </div>
    <ul class="rail__track">
      {words.map((w) => <li>{w}</li>)}
    </ul>
    <div class="wrap rail__foot">
      <span class="rail__bar" aria-hidden="true"><span></span></span>
    </div>
  </div>
</section>

<style>
  .rail { padding-block: var(--section); border-top: 1px solid var(--ink-line); }
  .rail__track {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--brass-soft);
  }
  .rail__bar { display: none; }

  /* ---------------- pinned, scroll-driven version ---------------- */
  :global(.story) .rail { padding: 0; height: var(--rail-h, 360svh); }
  :global(.story) .rail__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    padding-block: calc(var(--hdr, 80px) + 0.5rem) calc(var(--sticky-bar) + 0.75rem);
  }
  :global(.story) .rail__track {
    flex-wrap: nowrap;
    gap: 0.5em;
    margin-top: clamp(1.5rem, 1rem + 4svh, 4rem);
    padding-inline: 50vw;
    font-size: clamp(4.2rem, 2rem + 11vw, 12rem);
    line-height: 1;
    white-space: nowrap;
    transform: translate3d(calc(var(--x, 0) * -1px), 0, 0);
    will-change: transform;
  }
  :global(.story) .rail__track li {
    color: rgba(233, 205, 134, calc(var(--f, 0)));
    -webkit-text-stroke: 1px rgba(233, 205, 134, calc(0.35 + var(--f, 0) * 0.65));
    text-shadow: 0 0 calc(var(--f, 0) * 40px) rgba(233, 205, 134, calc(var(--f, 0) * 0.35));
    transform: translate3d(0, calc((1 - var(--f, 0)) * 0.06em), 0);
  }
  :global(.story) .rail__foot { margin-top: clamp(1.5rem, 1rem + 4svh, 4rem); }
  :global(.story) .rail__bar {
    display: block;
    height: 1px;
    max-width: 320px;
    background: var(--ink-line);
  }
  :global(.story) .rail__bar span {
    display: block;
    height: 100%;
    background: var(--brass-soft);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rails = Array.from(document.querySelectorAll<HTMLElement>('[data-rail]'));

  if (!reduce && rails.length) {
    document.documentElement.classList.add('story');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const state = rails.map((el) => ({
      el,
      track: el.querySelector<HTMLElement>('.rail__track')!,
      words: Array.from(el.querySelectorAll<HTMLElement>('.rail__track li')),
      bar: el.querySelector<HTMLElement>('.rail__bar span'),
      travel: 0,
    }));

    // One pixel down moves the words one pixel left, so the section is as
    // tall as the sideways distance plus a screen. Starts and ends with a
    // word centred, since the track is padded by half a screen each side.
    const measure = () => {
      state.forEach((s) => {
        const first = s.words[0], last = s.words[s.words.length - 1];
        const startX = first.offsetLeft + first.offsetWidth / 2;
        const endX = last.offsetLeft + last.offsetWidth / 2;
        s.travel = Math.max(endX - startX, 0);
        s.track.dataset.start = String(startX - window.innerWidth / 2);
        s.el.style.setProperty('--rail-h', `${s.travel * 0.7 + window.innerHeight * 1.2}px`);
      });
    };

    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = window.innerHeight, mid = window.innerWidth / 2;
      state.forEach((s) => {
        const r = s.el.getBoundingClientRect();
        if (r.bottom < -vh || r.top > vh * 2) return;
        const p = clamp(-r.top / Math.max(r.height - vh, 1));
        const x = Number(s.track.dataset.start || 0) + p * s.travel;
        s.track.style.setProperty('--x', x.toFixed(1));
        if (s.bar) s.bar.style.setProperty('--p', p.toFixed(3));
        s.words.forEach((w) => {
          const wr = w.getBoundingClientRect();
          const d = Math.abs(wr.left + wr.width / 2 - mid) / Math.max(wr.width * 0.5 + 40, 1);
          w.style.setProperty('--f', clamp(1.25 - d).toFixed(3));
        });
      });
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    let lastW = window.innerWidth;
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', () => {
      if (window.innerWidth !== lastW) { lastW = window.innerWidth; measure(); }
      request();
    }, { passive: true });
    window.addEventListener('load', () => { measure(); request(); });
    document.fonts?.ready.then(() => { measure(); request(); });
    measure();
    frame();
  }
</script>
