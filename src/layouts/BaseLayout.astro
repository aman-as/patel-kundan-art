---
import '../styles/global.css';
import '../styles/scroll.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import SiteMotion from '../components/SiteMotion.astro';
import ScrollStory from '../components/ScrollStory.astro';
import { site, fullAddress, contacts, formatPhone, url } from '../data/site';
import garamond from '../assets/fonts/eb-garamond-latin.woff2?url';
import inter from '../assets/fonts/inter-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Set on the page that should carry the LocalBusiness schema (home only). */
  isHome?: boolean;
  /** Keeps the page out of Google (the not-found page). */
  noindex?: boolean;
}

const { title, description, isHome = false, noindex = false } = Astro.props;
// every page is built as a folder, so its address ends in a slash
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
/* Derived from astro.config, so the schema follows the site when the domain
   changes instead of pointing at a URL that does not exist yet. */
const homeUrl = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href;
/* The picture WhatsApp and Google show when a link to the site is shared:
   the opening frame of the film (a sketch, not a finished piece). */
const shareImage = new URL(url('/video/film-poster.jpg'), Astro.site).href;

/* ---------------------------------------------------------------------------
   Structured data is generated from src/data/site.ts, so what Google reads can
   never drift from what the page displays. Unverified fields (hours, founding
   year) are omitted entirely rather than guessed.
--------------------------------------------------------------------------- */
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'JewelryStore'],
  '@id': `${homeUrl}#business`,
  name: site.brand,
  alternateName: site.entities.filter((n) => n !== site.brand),
  description: site.description,
  url: homeUrl,
  telephone: contacts.filter((c) => c.call).map((c) => formatPhone(c.number)),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.locality}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  areaServed: 'IN',
  knowsAbout: ['Kundan jewellery', 'Jadau jewellery', 'Polki', 'Gold jewellery', 'Silver jewellery', 'Jewellery manufacturing', 'Jewellery job work'],
};

if (site.hours.length) {
  schema.openingHoursSpecification = site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  }));
}
if (site.foundedYear) schema.foundingDate = String(site.foundedYear);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A090B" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    {/* the two font files (global.css) start loading with the page */}
    <link rel="preload" href={garamond} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Marks the document as script-capable before first paint, so the
        scroll fade-in can hide sections without ever hiding them from a
        visitor (or a crawler) that has no JavaScript. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      // the scroll-story layout is set before the first paint, so nothing
      // jumps when the page scripts arrive a moment later
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('story');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyContactBar />

    <SiteMotion />
    <ScrollStory />
  </body>
</html>
