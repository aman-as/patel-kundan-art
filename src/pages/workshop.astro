---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactButtons from '../components/ContactButtons.astro';
import CraftStages from '../components/CraftStages.astro';
import { site } from '../data/site';

// The stages a kundan piece can pass through. Which ones a piece needs
// depends on its design; the page never says who does which stage.
const stages = [
  {
    title: 'Drawing', word: 'नक्शा', roman: 'Naksha',
    text: 'A design or reference guides the layout, the proportions and where each stone and decorative detail will sit.',
    who: 'The naqqash or chitera, the designer',
  },
  {
    title: 'Frame', word: 'घाट', roman: 'Ghaat',
    text: 'The gold framework gives the piece its form, with a seat for every stone. Everything that follows is built on it.',
    who: 'The sonar, the goldsmith',
  },
  {
    title: 'Engraving', word: 'खुदाई', roman: 'Khudai',
    text: 'Where the design carries enamel, the gold is engraved so that each colour has a hollow to sit in.',
    who: 'The engraver',
  },
  {
    title: 'Enamel', word: 'मीना', roman: 'Meena',
    text: 'For designs with meenakari, the colour work is completed as the design requires, before the stones are set.',
    who: 'The meenakar',
    look: 'A smooth, finished back',
  },
  {
    title: 'Lac bed', word: 'लाख', roman: 'Laakh',
    text: 'In traditional kundan work, the hollows of the frame are filled with lac, a natural resin that forms the bed for each stone.',
    who: 'The setter',
  },
  {
    title: 'Setting', word: 'जड़ाई', roman: 'Jadai',
    text: 'Each stone is carefully set by hand. A thin layer of silver foil is placed behind the stone to enhance light reflection and depth. Fine gold foil is then worked carefully around the stone’s edges to hold it securely in place. This precise setting technique contributes to the distinctive brilliance and finish of traditional kundan jewellery.',
    who: 'The jadiya or kundansaz, the setter',
    look: 'Even, tight gold edges, and stones that do not move when pressed',
  },
  {
    title: 'Finishing', word: 'छिलाई', roman: 'Chhilai',
    text: 'The piece is cleaned and finished according to the design, with attention to the edges, the setting and how it looks as a whole.',
    who: 'The finisher',
  },
  {
    title: 'Stringing', word: 'पटवा', roman: 'Patwa',
    text: 'Where the design needs them, silk threads, pearls and beads are added, and the piece is assembled, ready to wear.',
    who: 'The patwa, the stringer',
  },
];

const words = [
  { term: 'Kundan', meaning: 'Fine gold foil, worked around the edges of each stone to hold it in place, with no claws.' },
  { term: 'Jadau', meaning: 'The craft of setting stones into gold this way. The word comes from jad, to embed.' },
  { term: 'Polki', meaning: 'Flat, uncut diamonds, traditionally set in kundan.' },
  { term: 'Kundan-meena', meaning: 'Kundan setting on the front, enamel on the back.' },
];
---

<BaseLayout
  title="Our Workshop & Kundan Craft | Patel Kundan Art, Delhi"
  description="Meet Patel Kundan Art, a family-run jewellery manufacturing workshop in Karol Bagh, Delhi, specialising in kundan and jadau and undertaking custom gold and silver jewellery work."
>
  <PageHero
    eyebrow="Our workshop · Karol Bagh, New Delhi"
    title="A family workshop, built around the craft."
    lede="Patel Kundan Art is a family-run jewellery manufacturing workshop in Karol Bagh, Delhi. Kundan setting is our speciality, and we make custom gold and silver jewellery for individuals, retail jewellers and jewellery businesses."
  >
    <ContactButtons waLabel="Speak to the workshop" />
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">What we make</p>
        <h2>Kundan is our speciality. It is not our only work.</h2>
      </div>
      <div class="prose">
        <p>
          We manufacture kundan and jadau jewellery and also take on other gold and silver
          jewellery. Work may begin with a drawing, a photograph, a sample, an existing piece
          or a conversation about the result you want.
        </p>
        <p>
          The techniques and stages involved depend on the design, and we explain the approach
          before the job is confirmed.
        </p>
      </div>
    </div>
  </section>

  <!-- HOW A PIECE IS MADE -->
  <CraftStages
    id="how-a-piece-is-made"
    eyebrow="How a kundan piece is made"
    title="The details behind a kundan piece."
    lede="Kundan jewellery brings several stages of craft together. Depending on the design, a piece may pass through drawing, a framework, engraving and enamel, the setting of the stones, finishing and stringing. Each stage shapes how the finished piece looks and holds together."
    stages={stages}
    words={words}
  />

  <!-- THE REGISTER -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Materials &amp; accountability</p>
        <h2>Every job begins with clarity.</h2>
      </div>
      <div class="prose">
        <p>
          When a job involves gold you give us, it is weighed and written into our job
          register when it comes in. The weighing, the work and the handover are discussed
          before the job goes ahead. When the piece is finished, it is weighed against the
          same entry.
        </p>
        <p>
          Many customers do not bring gold at all, and pay for the gold and the making together.
          Either way, the design, the weight and the work are agreed before we start.
        </p>
        <p>
          We take this seriously because the material has value, and often carries personal
          or business meaning as well.
        </p>
        <!-- TODO: photograph of a real register page goes here. It is the single
             most persuasive image the site can carry. -->
      </div>
    </div>
  </section>

  <section class="section on-sunk">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2>Craft deserves clear communication.</h2>
      </div>
      <div class="prose">
        <p>
          Good work begins with listening carefully. We discuss the design and what you need,
          make clear what the job involves, and give an estimate and expected timeline before
          work begins.
        </p>
        <p>
          If a design has a limitation, we explain it plainly rather than make a promise we
          cannot keep.
        </p>
      </div>
    </div>
  </section>

  <section class="section on-ink page-close">
    <div class="wrap wrap--narrow">
      <h2>Meet us at the workshop.</h2>
      <p class="lede">
        We are at {site.address.street}, {site.address.locality}, New Delhi. Call or message
        before visiting so we can arrange a convenient time.
      </p>
      <ContactButtons waLabel="Message us" link={{ href: site.mapsUrl, label: 'Get Directions', external: true }} />
    </div>
  </section>
</BaseLayout>
