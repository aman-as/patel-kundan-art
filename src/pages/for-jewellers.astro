---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactButtons from '../components/ContactButtons.astro';
import Makes from '../components/Makes.astro';
import Faq from '../components/Faq.astro';

const services = [
  {
    h: 'Custom manufacturing',
    p: 'Work from your design or reference, with the specifications and finish discussed before the job begins.',
  },
  {
    h: 'Kundan and jadau work',
    p: 'Our specialist area. Share the design and setting requirements so we can discuss the right approach.',
  },
  {
    h: 'Gold and silver jewellery',
    p: 'We take on custom manufacturing across gold and silver jewellery, to the design and the specifications agreed.',
  },
  {
    h: 'Repeat styles and continuing requirements',
    p: 'If you need a style made again or want to discuss an ongoing line, share the reference and what you expect to need. Timing and capacity are discussed for each job.',
  },
  {
    h: 'Job work with your material',
    p: 'Where you supply the gold or other materials, the intake, recording, work and handover are discussed so both sides know exactly how the job will run.',
  },
];

const matters = [
  {
    h: 'Clear job discussion',
    p: 'We make clear the piece, the design reference, the materials, the finish, the estimate and the expected timeline before confirming the work.',
  },
  {
    h: 'Material recording',
    p: 'Gold you supply is weighed and recorded at intake. At handover, it is reviewed against the job record and the agreed terms.',
  },
  {
    h: 'Respect for your customer relationship',
    p: 'You are building a business and serving your own customers. We talk to you about the job, and keep your designs and references private.',
  },
  {
    h: 'Direct access to the workshop',
    p: 'You discuss the requirements with the people who coordinate the orders, the kundan setting and the finishing.',
  },
  {
    h: 'One-off jobs and repeat requirements',
    p: 'We can discuss a single manufacturing job or a possible repeat requirement. Quantity, rate and timeline depend on the work and the capacity available.',
  },
];

const makes = [
  'Kundan', 'Jadau', 'Polki', 'Bridal sets', 'Chokers', 'Long necklaces',
  'Earrings', 'Pendants', 'Rings', 'Bangles', 'Antique finish', 'Silver jewellery',
];

const share = [
  'A design image, sketch, photograph or sample',
  'The type of jewellery and the finish you want',
  'Gold, silver or another specified material',
  'Approximate weight or budget, if you know it',
  'Quantity, or whether the job may repeat',
  'The delivery date you have in mind',
];

const faq = [
  {
    q: 'Do you publish fixed rates?',
    a: 'We give estimates job by job, because the cost depends on the design, material, weight, finish and work required. Share a reference for a discussion about your job.',
  },
  {
    q: 'Do you accept repeat manufacturing orders?',
    a: 'Yes, you can contact us to discuss repeat styles or ongoing requirements. Quantities, rates and timelines depend on the specifications and the capacity available.',
  },
];
---

<BaseLayout
  title="Kundan Jewellery Manufacturing & Job Work for Jewellers | Delhi"
  description="Manufacturing and job work for retail jewellers and jewellery businesses. Patel Kundan Art specialises in kundan and jadau and takes on custom gold and silver jewellery requirements in Karol Bagh, Delhi."
>
  <PageHero
    eyebrow="For retail jewellers &amp; jewellery businesses"
    title="A manufacturing partner for your jewellery designs."
    lede="Patel Kundan Art is a jewellery manufacturing workshop in Karol Bagh, Delhi. Kundan and jadau are our specialities, and we also take on custom gold and silver jewellery work beyond these styles."
  >
    <p class="sub">
      Bring us a drawing, a reference photograph, a sample or a customer requirement. We discuss
      the design, the work, the materials, the estimate and the timeline before the job is confirmed.
    </p>
    <ContactButtons message="trade" waLabel="Discuss trade work" />
  </PageHero>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we do for jewellers</p>
      <h2 class="h">Manufacturing shaped around the job.</h2>
      <ul class="points">
        {services.map((s, i) => (
          <li class={`reveal ${i % 2 ? 'reveal--right' : 'reveal--left'}`}>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-sunk">
    <div class="wrap">
      <p class="eyebrow">What matters to a jeweller</p>
      <h2 class="h">A workshop relationship needs more than workmanship.</h2>
      <ul class="points">
        {matters.map((m, i) => (
          <li class={`reveal ${i % 2 ? 'reveal--right' : 'reveal--left'}`}>
            <h3>{m.h}</h3>
            <p>{m.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">What we can make</p>
        <h2>Kundan is the speciality. The brief can be broader.</h2>
      </div>
      <div class="prose">
        <p>
          We specialise in kundan and jadau, and also take on custom gold and silver jewellery.
          Work may include bridal pieces, chokers, long necklaces, earrings, pendants, rings,
          bangles, antique-look finishes and other styles, depending on the design and the
          specifications.
        </p>
        <p>
          We can start from a drawing, a reference photograph, a sample piece or a discussion of
          what your customer needs. The list is not complete; send us the actual brief.
        </p>
        <p class="gold">
          With gold where it is, every gram counts. Kundan and polki give a piece a rich, full
          look without the gold weight, so the set still looks like a set, at a price your
          customer can say yes to.
        </p>
      </div>
    </div>
  </section>

  <Makes items={makes} class="makes--tight" />

  <section class="section on-sunk">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Getting a quote</p>
        <h2>Send us the details. We will discuss the job.</h2>
      </div>
      <div class="prose">
        <p>For a useful first discussion, share whatever you have:</p>
        <ul class="share">
          {share.map((s) => <li>{s}</li>)}
        </ul>
        <p>
          You do not need every answer ready. We can fill in the missing details as we talk.
          Rates, minimum quantities where they apply, and delivery times depend on the job, its
          complexity and the work in hand, so we quote for your requirement rather than
          publishing one rate for everything.
        </p>
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <section class="section on-ink page-close">
    <div class="wrap wrap--narrow">
      <h2>Have a job to discuss?</h2>
      <p class="lede">
        Send your design or requirements. We will discuss the work involved, what we need for
        an estimate, and the next steps.
      </p>
      <ContactButtons message="trade" waLabel="Send a trade enquiry" />
    </div>
  </section>
</BaseLayout>

<style>
  .sub { max-width: 50ch; font-size: 0.98rem; color: var(--silver-soft); }
  .h { max-width: 20ch; margin-top: 0.75rem; }
  .gold { padding-top: 1.1rem; border-top: 1px solid var(--ivory-line); color: var(--brass); }
  .share { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.45rem; }
  .share li::marker { color: var(--brass); }
  :global(.makes--tight) { padding-top: 0; }
</style>
