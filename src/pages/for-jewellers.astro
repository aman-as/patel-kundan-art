---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactButtons from '../components/ContactButtons.astro';
import Makes from '../components/Makes.astro';

const assurances = [
  {
    h: 'Your design stays yours',
    p: 'What you give us is made for you alone, and your designs stay with your shop.',
  },
  {
    h: 'Gold in, gold out',
    p: 'Every job is weighed in and weighed out against a written register, so you always have a clear account of your gold.',
  },
  {
    h: 'Direct from our workshop',
    p: 'The work is done in our own workshop in Karol Bagh. When you call, you are speaking to the people setting the stones.',
  },
  {
    h: 'Made for your counter',
    p: 'Every piece is made to order for the jeweller who asked for it. We are your workshop, so your customers stay yours.',
  },
];
---

<BaseLayout
  title="Kundan Job Work for Jewellers, Karol Bagh | Patel Kundan Art"
  description="Kundan and jadau jewellery manufacturing and job work for retail jewellers and jewellery businesses. Handmade to order in Karol Bagh, Delhi."
>
  <PageHero
    eyebrow="For jewellers &amp; businesses"
    title="A kundan manufacturing partner in Karol Bagh."
    lede="We manufacture kundan, jadau and antique-finish jewellery for retail jewellers and jewellery businesses. You bring the design, the reference or the requirement — we make the piece."
  >
    <p class="first">
      Call us or message us on WhatsApp about the piece. We will tell you what
      it will weigh and what the work involves, before you commit to anything.
    </p>
    <ContactButtons message="trade" waLabel="WhatsApp us about trade work" />
  </PageHero>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What matters to a retailer</p>
      <h2>Four things you want settled before you hand over gold.</h2>
      <ul class="cards">
        {assurances.map((a, i) => (
          <li class={`reveal ${i % 2 ? 'reveal--right' : 'reveal--left'}`}>
            <h3>{a.h}</h3>
            <p>{a.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Makes />

  <section class="section on-sunk">
    <div class="wrap wrap--narrow prose">
      <h2>The piece your customer can still say yes to</h2>
      <p>
        At today's gold prices, every gram counts. Kundan and polki
        give a piece visual size without the gold weight behind it — the set
        still looks like a set, and the bill is one your customer can pay.
        Lightweight is where demand has moved, and it is the work we specialise in.
      </p>
      <h2>What we can take on</h2>
      <p>
        Kundan and jadau setting is our specialisation. Beyond that we manufacture
        across gold jewellery — bridal sets, chokers, rani haar, bangles, earrings,
        pendants and rings, in antique and polished finishes. Gold is the bulk of
        what leaves this bench, and silver pieces get the same setting work and
        the same care.
      </p>
      <p>
        Work can start from your design, a sample piece, or a rough idea we
        develop with you. Repeat orders and continuing lines are always welcome.
      </p>
      <h2>Rates and delivery times</h2>
      <p>
        Rates, minimum quantities and delivery times depend on the piece, the season
        and how much work is on the bench, so we quote for each job. Call us and we
        will give you clear figures for yours.
      </p>
    </div>
  </section>

  <section class="section on-ink page-close">
    <div class="wrap wrap--narrow">
      <h2>Tell us about the job, and we will tell you what it involves.</h2>
      <p class="lede">
        One call or one WhatsApp message is enough to start.
      </p>
      <ContactButtons message="trade" waLabel="WhatsApp us about trade work" />
    </div>
  </section>
</BaseLayout>

<style>
  .cards {
    list-style: none;
    margin: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 700px) { .cards { grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; } }
  .cards li { padding-top: 1.1rem; border-top: 1px solid var(--ivory-line); }
  .cards h3 { font-size: var(--step-1); }
  .cards p { color: var(--text-muted); margin-top: 0.45rem; }
  .first {
    max-width: 46ch;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--silver-soft);
  }
</style>
