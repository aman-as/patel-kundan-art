---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ScrollWords from '../components/ScrollWords.astro';
import KundanMotif from '../components/KundanMotif.astro';
import WordRail from '../components/WordRail.astro';
import { site, url } from '../data/site';

const makes = [
  'Kundan', 'Jadau', 'Polki', 'Antique finish', 'Bridal sets',
  'Chokers', 'Rani haar', 'Bangles', 'Earrings', 'Pendants', 'Rings',
  'Silver jewellery',
];

const steps: [string, string][] = [
  ['Design', 'You send a photograph, a drawing or a piece to copy.'],
  ['Weight', 'We tell you what the piece needs before anything begins.'],
  ['Gold in', 'Received, weighed and entered in the job register.'],
  ['Ghaat', 'The gold framework is built by hand.'],
  ['Kundan setting', 'The specialist stage, and the one we are known for.'],
  ['Finish', 'Polished, weighed out, delivered against the same register.'],
];
---

<BaseLayout
  title="Patel Kundan Art — Kundan Jewellery Manufacturer in Karol Bagh, Delhi"
  description={site.description}
  isHome
>
  <!-- HERO -->
  <section class="hero on-ink">
    <HeroCanvas />
    <div class="wrap hero__inner">
      <div class="hero__text enter">
        <p class="eyebrow">Kundan &amp; Jadau Jewellery Manufacturing</p>
        <h1>You bring the design.<br />We make it.</h1>
        <p class="lede">{site.subline}</p>
        <ContactButtons class="hero__cta" waLabel="WhatsApp us" />
        <p class="firststep">
          Send one photograph. We will tell you what the piece will weigh and
          what the work involves — before you commit anything.
        </p>
      </div>
    </div>
  </section>

  <!-- GIANT TYPE, PINNED: ends by flying through the word -->
  <ScrollWords
    lines={['Gold is our trade.', 'Kundan is our craft.', 'Every piece, by hand.']}
    finale="Kundan."
  />

  <!-- THE LIGHTWEIGHT ANGLE -->
  <section class="section on-ink lightweight">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Why kundan, now</p>
      <h2 class="scrub-h" data-scrub>
        <span data-scrub-text>Your customer still wants a set</span>
        <span class="gild" data-scrub-text>that looks like a set.</span>
      </h2>
      <p class="lede">
        With gold where it is, weight is what kills the sale. Kundan and polki
        give a piece visual size without the gold weight behind it — which is
        what a customer can still say yes to this season.
      </p>
      <p class="lede">
        It is the reason this is the work we chose to be good at.
      </p>
    </div>
  </section>

  <!-- THE FORK -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Who we work with</p>
      <h2>Two ways to work with us.</h2>
      <div class="fork">
        <a class="path reveal reveal--left" href={url('/for-jewellers/')}>
          <h3>For jewellers &amp; businesses</h3>
          <p>
            Manufacturing and job work for retail jewellers. Your design stays yours,
            and every job is weighed in and weighed out against a written register.
          </p>
          <span class="path__go">Trade &amp; job work →</span>
        </a>
        <a class="path reveal reveal--right" href={url('/custom-orders/')}>
          <h3>For individuals</h3>
          <p>
            One piece, made to order — and jewellery you already own, remade.
            The set from a wedding a generation ago that nobody wears, turned
            into something that gets worn.
          </p>
          <span class="path__go">Custom orders &amp; remaking old gold →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT WE MAKE: giant words sliding sideways -->
  <WordRail
    words={makes}
    eyebrow="What we make"
    title="Kundan is our specialisation.<br />Gold is our trade, and we work in silver too."
  />
  <section class="section on-ink makes-note">
    <div class="wrap">
      <p class="prose note">
        Silver we take on properly, not as a favour — a kundan setting is the
        same work whichever metal it sits in.
      </p>
      <p class="prose note">
        Every piece is made to order, and each one is different. Send us a
        photograph or a reference and we will tell you whether we can make it.
      </p>
    </div>
  </section>

  <!-- HOW A JOB RUNS: a kundan medallion drawn as you scroll -->
  <KundanMotif steps={steps} eyebrow="How a job runs" title="From a photograph on WhatsApp to a finished piece.">
    <p class="more"><a class="ulink" href={url('/workshop/')}>More about how we work →</a></p>
  </KundanMotif>

  <!-- CLOSING -->
  <section class="section on-ink closing">
    <div class="wrap wrap--narrow">
      <h2>Send one photograph of what you need made.</h2>
      <p class="lede">
        We will tell you what it will weigh, what the work involves, and honestly
        whether it is a piece we can do well. Before you commit anything.
      </p>
      <ContactButtons class="closing__cta" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    align-items: center;
  }
  @media (min-width: 900px) { .hero { min-height: min(70vh, 600px); } }
  /* Scrim between the dust and the words. It must sit ABOVE the canvas
     (z-index 1) — as a z-index:0 sibling the canvas simply painted over it.
     The linear pass darkens the text column; the radial keeps the middle of
     the mark from washing out the headline. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg,
      rgba(10, 9, 11, 0.9) 0%, rgba(10, 9, 11, 0.6) 26%,
      rgba(10, 9, 11, 0.24) 44%, transparent 62%);
  }
  /* Phones: the mark sits upper-right, beside the headline, so the scrim
     holds the left text column and releases just past halfway. */
  @media (max-width: 899px) {
    .hero::after {
      background: linear-gradient(90deg,
        rgba(10, 9, 11, 0.96) 0%, rgba(10, 9, 11, 0.92) 47%,
        rgba(10, 9, 11, 0.3) 61%, transparent 80%);
    }
  }
  .hero__inner { position: relative; z-index: 2;
    /* The mark now sits to the RIGHT at every width, so the text no longer
       needs to clear anything above it. */
    padding-block: clamp(2.25rem, 1.75rem + 2.5vw, 3.25rem);
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hero__text { display: grid; gap: 1.15rem; justify-items: start; }
  .hero h1 { max-width: 15ch; }
  .hero .lede { max-width: 46ch; }
  .hero__cta { margin-top: 0.6rem; }

  .firststep {
    max-width: 44ch;
    margin-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--silver-soft);
  }
  .lightweight { border-top: 1px solid var(--ink-line); }
  .lightweight h2 { margin-bottom: 1.15rem; }
  .scrub-h { font-size: var(--step-4); max-width: 18ch; }
  .lightweight .lede + .lede { margin-top: 1rem; color: var(--brass-soft); }

  .more { margin-top: 2.25rem; }
  .more a {
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .on-ink .more a { color: var(--brass-soft); }

  .fork {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
  }
  @media (min-width: 780px) { .fork { grid-template-columns: 1fr 1fr; gap: 1.75rem; } }
  .path {
    display: block;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    border: 1px solid var(--ivory-line);
    border-radius: var(--radius);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .path:hover { border-color: var(--brass); transform: translateY(-2px); }
  .path p { color: var(--text-muted); margin-top: 0.7rem; }
  .path__go {
    display: inline-block;
    margin-top: 1.1rem;
    color: var(--brass);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .note { margin-top: 1.25rem; color: var(--text-on-ink-muted); }
  .makes-note { padding-top: 0; }


  .closing { text-align: left; }
  .closing__cta { margin-top: 1.75rem; }
</style>
