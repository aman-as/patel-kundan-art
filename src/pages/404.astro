---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactButtons from '../components/ContactButtons.astro';
import { url, pages } from '../data/site';
---

<BaseLayout
  title="Page not found — Patel Kundan Art"
  description="This page could not be found. Call or WhatsApp Patel Kundan Art, kundan jewellery makers in Karol Bagh, Delhi."
  noindex
>
  <PageHero
    eyebrow="Page not found"
    title="We could not find that page."
    lede="The link may be old or mistyped. Here are the pages of the site, and the workshop is one call or one message away."
  >
    <ul class="home">
      {pages.map((p) => <li><a href={url(p.path)}>{p.label}</a></li>)}
    </ul>
    <ContactButtons />
  </PageHero>
</BaseLayout>

<style>
  .home {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .home a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--brass-soft);
    text-decoration: none;
    border-bottom: 1px solid rgba(233, 205, 134, 0.35);
  }
  .home a:hover { border-bottom-color: var(--brass-soft); }
</style>
